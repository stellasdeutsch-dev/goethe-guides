---
interface Props { type?: 'tip' | 'trap' | 'life' | 'info'; title?: string }
const { type = 'tip', title } = Astro.props;
const icon = { tip: 'lightbulb', trap: 'triangle-alert', life: 'zap', info: 'info' }[type];
const def = { tip: 'Совет', trap: 'Подвох', life: 'Лайфхак', info: 'Важно' }[type];
---
<aside class={`callout ${type}`}>
  <span class="callout-ic" aria-hidden="true"><svg class="ic"><use href={`#i-${icon}`} /></svg></span>
  <div><b class="callout-t">{title ?? def}</b><slot /></div>
</aside>
