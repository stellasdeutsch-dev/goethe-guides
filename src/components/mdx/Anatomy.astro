---
/* Разбор письма по частям: кнопки подсвечивают кусок текста, внизу пояснение и счётчик слов. */
interface Part {
  id: string;
  label: string;
  color: string;
  ink?: string;
  text: string;
  note: string;
}
interface Props {
  to: string;
  subject: string;
  parts: Part[];
}
const { to, subject, parts } = Astro.props;
const words = (t: string) => t.trim().split(/\s+/).filter(Boolean).length;
const total = parts.reduce((n, p) => n + words(p.text), 0);
---
<div class="anat rv" data-anat data-total={total}>
  <div class="bar" role="group" aria-label="Части письма">
    {parts.map((p) => (
      <button type="button" data-p={p.id} aria-pressed="false" style={`--c:${p.color};--k:${p.ink ?? '#fff'}`}>
        <i></i>{p.label}
      </button>
    ))}
  </div>
  <div class="mail" lang="de">
    <div class="mh">
      <span>An: <b>{to}</b></span>
      <span>Betreff: <b>{subject}</b></span>
    </div>
    {parts.map((p) => (
      <span class="part" data-part={p.id} data-note={p.note} data-words={words(p.text)} style={`--c:${p.color};--k:${p.ink ?? '#fff'}`}>
        {p.text}
        <button class="say" type="button" data-say={p.text} aria-label="Озвучить"><svg><use href="#i-volume-2" /></svg></button>
      </span>
    ))}
  </div>
  <p class="note"><svg class="ic"><use href="#i-brain" /></svg><span>Жми на части письма сверху. Каждая делает свою работу.</span></p>
  <div class="cnt"><span>Всё письмо: <b>{total}</b> слов</span><span data-cnt hidden>Эта часть: <b></b> слов</span></div>
</div>

<script>
  import { $, $$, G, onReady, whenVisible } from '../../scripts/lib';

  onReady(() => {
    $$('[data-anat]').forEach((root) => {
      const btns = $$<HTMLButtonElement>('.bar button', root);
      const parts = $$('.part', root);
      const note = $('.note span', root)!;
      const cnt = $<HTMLElement>('[data-cnt]', root)!;
      const defNote = note.textContent || '';
      let current = '';

      function show(id: string) {
        current = id;
        root.classList.toggle('focus', !!id);
        btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.p === id)));
        const on = parts.filter((p) => p.dataset.part === id);
        parts.forEach((p) => p.classList.toggle('on', p.dataset.part === id));
        note.textContent = id ? on[0]?.dataset.note || '' : defNote;
        cnt.hidden = !id;
        if (id) $('b', cnt)!.textContent = String(on.reduce((n, p) => n + Number(p.dataset.words || 0), 0));
        const g = G();
        if (g && on[0]) g.fromTo(on[0], { scale: 0.97 }, { scale: 1, duration: 0.5, ease: 'back.out(3)' });
      }

      // Автопоказ: один круг по частям, пока человек сам не нажал.
      let auto = 0, i = 0, touched = false;
      const stop = () => { clearInterval(auto); auto = 0; };
      whenVisible(root, () => {
        if (touched || auto || i >= btns.length) return;
        auto = window.setInterval(() => {
          if (i >= btns.length) { stop(); show(''); return; }
          show(btns[i++].dataset.p || '');
        }, 1700);
      }, stop, 0.5);

      btns.forEach((b) =>
        b.addEventListener('click', () => {
          touched = true; stop();
          show(current === b.dataset.p ? '' : b.dataset.p || '');
        }),
      );
    });
  });
</script>
