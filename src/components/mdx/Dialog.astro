---
/* Диалог в виде переписки: нажми на реплику, чтобы услышать. «Слушать всё» читает по очереди. */
interface Line {
  who: 'A' | 'B' | 'C';
  name?: string;
  de: string;
  ru?: string;
}
interface Props {
  title?: string;
  lines: Line[];
}
const { title = 'Диалог', lines } = Astro.props;
const hasRu = lines.some((l) => l.ru);
---
<div class="ix rv" data-dialog>
  <div class="ix-h">
    <b><svg class="ic"><use href="#i-messages-square" /></svg>{title}</b>
    <span style="display:flex;gap:6px">
      <button class="btn sm" type="button" data-all data-tts-only><svg class="ic"><use href="#i-play" /></svg><span>Слушать всё</span></button>
      {hasRu && <button class="btn sm gray" type="button" data-ru aria-pressed="true">RU</button>}
    </span>
  </div>
  <div class="dlg" lang="de">
    {lines.map((l, i) => {
      const prev = lines[i - 1];
      const showName = l.name && (!prev || prev.who !== l.who);
      return (
        <div class={`msg ${l.who}`}>
          {showName && <span class="nm">{l.name}</span>}
          <button class="bub" type="button" data-say={l.de} data-line={i}>{l.de}</button>
          {l.ru && <span class="tr" lang="ru">{l.ru}</span>}
        </div>
      );
    })}
  </div>
</div>

<script>
  import { $, $$, hush, onReady, say } from '../../scripts/lib';

  onReady(() => {
    $$('[data-dialog]').forEach((root) => {
      const bubs = $$<HTMLButtonElement>('.bub', root);
      const all = $<HTMLButtonElement>('[data-all]', root);
      const ru = $<HTMLButtonElement>('[data-ru]', root);
      let playing = false;
      const setAll = (on: boolean) => {
        playing = on;
        if (all) all.innerHTML = `<svg class="ic"><use href="#i-${on ? 'pause' : 'play'}"/></svg><span>${on ? 'Стоп' : 'Слушать всё'}</span>`;
      };
      function playFrom(i: number) {
        if (!playing || i >= bubs.length) { setAll(false); return; }
        bubs[i].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        say(bubs[i].dataset.say || '', bubs[i], { onend: () => setTimeout(() => playFrom(i + 1), 350) });
      }
      all?.addEventListener('click', () => {
        if (playing) { setAll(false); hush(); bubs.forEach((b) => b.classList.remove('on')); return; }
        setAll(true);
        playFrom(0);
      });
      // Клик по реплике во время «слушать всё» останавливает общий проигрыватель.
      bubs.forEach((b) => b.addEventListener('pointerdown', () => playing && setAll(false)));
      ru?.addEventListener('click', () => {
        const on = ru.getAttribute('aria-pressed') !== 'true';
        ru.setAttribute('aria-pressed', String(on));
        $('.dlg', root)!.classList.toggle('hide-ru', !on);
        ru.classList.toggle('gray', on);
      });
    });
  });
</script>
