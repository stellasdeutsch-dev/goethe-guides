---
/* Бланк ответов к официальному пробнику: задания решают в PDF, ответы отмечают здесь.
   Таймер, подсчёт баллов (у telc бывают половинки), объяснение к каждому заданию после проверки. */
interface Item { n: number | string; part: string; o: string[]; a: number; why: string; q?: string }
interface Props {
  id: string; title: string; minutes?: number; items: Item[];
  /** Баллы за верный ответ. По умолчанию maxPoints / число заданий. */
  factor?: number; maxPoints?: number;
  /** Порог в баллах. Без него вердикт не показываем. */
  pass?: number; source?: string; hint?: string;
  level?: string; module?: string;
}
const { id, title, minutes = 0, items, factor, maxPoints = 100, pass, source, hint } = Astro.props;
const level = (Astro.props.level ?? id.match(/(?:^|-)(a1|a2|b1|b2|c1|c2)(?:-|$)/i)?.[1] ?? '').toUpperCase();
const module = Astro.props.module ?? (/lesen/.test(id) ? 'lesen' : /hoeren|hören/.test(id) ? 'hoeren' : /sprachbaust/.test(id) ? 'sprachbausteine' : '');
const fct = factor ?? maxPoints / items.length;
const esc = (s: string) => s.replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]!);
const fmt = (s: string) => esc(s).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');
const parts: { name: string; items: Item[] }[] = [];
for (const it of items) {
  let p = parts.find((x) => x.name === it.part);
  if (!p) parts.push((p = { name: it.part, items: [] }));
  p.items.push(it);
}
---
<div class="x sheet" data-ab data-id={id} data-title={title} data-level={level} data-module={module} data-min={minutes} data-factor={fct} data-max={maxPoints} data-pass={pass ?? ''}>
  <div class="x-h">
    <b><svg class="ic"><use href="#i-list-checks" /></svg>{title}</b>
    <span class="x-cap">{items.length} заданий{minutes ? ` · ${minutes} мин` : ''}</span>
  </div>
  <div class="timer">
    {minutes > 0 && <div class="timer-l"><output data-clock>{String(minutes).padStart(2, '0')}:00</output><small>Как на экзамене. Можно без таймера</small></div>}
    <div class="timer-r">
      {minutes > 0 && <button class="btn knob" type="button" data-start><span class="knob-i"><svg class="ic"><use href="#i-play" /></svg></span><span>Старт</span></button>}
      <button class="btn dark icon" type="button" data-reset aria-label="Начать заново"><svg class="ic"><use href="#i-rotate-ccw" /></svg></button>
    </div>
  </div>
  <p class="x-note">{hint ?? <>Решай в официальном материале{source && <> (<a href={source} rel="noopener" target="_blank">открыть PDF</a>)</>}. Здесь только отмечай ответы. Объяснения откроются после проверки.</>}</p>

  {parts.map((p) => (
    <fieldset class="sheet-part">
      <legend>{p.name}</legend>
      <div class="sheet-list">
        {p.items.map((it) => (
          <div class="sheet-row" data-n={it.n} data-a={it.a}>
            <span class="sheet-n">{it.n}</span>
            <div class="sheet-body">
              {it.q && <span class="sheet-q">{it.q}</span>}
              <div class="sheet-opts" role="radiogroup" aria-label={`Задание ${it.n}`}>
                {it.o.map((o, i) => <button type="button" role="radio" aria-checked="false" data-i={i}>{o}</button>)}
              </div>
              <div class="sheet-why" hidden><b>Ответ: {it.o[it.a]}.</b> <span set:html={fmt(it.why)} /></div>
            </div>
          </div>
        ))}
      </div>
    </fieldset>
  ))}

  <div class="sheet-foot">
    <button class="btn knob" type="button" data-check><span class="knob-i"><svg class="ic"><use href="#i-check" /></svg></span><span>Проверить</span></button>
    <span class="x-cap" data-prog>Отмечено 0 из {items.length}</span>
  </div>
  <div class="sheet-res" data-res hidden aria-live="polite"></div>
</div>

<script>
  import { $, $$, icon, onReady, pop, spring } from '../../scripts/lib';
  const num = (x: number) => String(Math.round(x * 10) / 10).replace('.', ',');

  onReady(() => {
    $$('[data-ab]').forEach((root) => {
      const key = `ab:${root.dataset.id}`;
      const rows = $$<HTMLElement>('.sheet-row', root);
      const factor = Number(root.dataset.factor);
      const max = Number(root.dataset.max);
      const passAt = root.dataset.pass ? Number(root.dataset.pass) : null;
      const res = $<HTMLElement>('[data-res]', root)!;
      const prog = $('[data-prog]', root)!;
      const checkBtn = $<HTMLButtonElement>('[data-check]', root)!;
      // Шаг баллов 0,5 (telc: 2,5 и 1,5 за ответ) считаем точно, остальное округляем как Goethe.
      const exactHalves = Number.isInteger(factor * 2);
      let answers: Record<string, number> = {};
      let checked = false;

      const save = () => { try { localStorage.setItem(key, JSON.stringify({ answers, checked })); } catch { /* ignore */ } };
      const updProg = () => { prog.textContent = `Отмечено ${Object.keys(answers).length} из ${rows.length}`; };
      const paint = (row: HTMLElement) => $$<HTMLButtonElement>('.sheet-opts button', row).forEach((b) => b.setAttribute('aria-checked', String(answers[row.dataset.n!] === Number(b.dataset.i))));

      rows.forEach((row) => $$<HTMLButtonElement>('.sheet-opts button', row).forEach((b) => b.addEventListener('click', () => {
        if (checked) return;
        const n = row.dataset.n!;
        const i = Number(b.dataset.i);
        if (answers[n] === i) delete answers[n]; else answers[n] = i;
        paint(row);
        updProg();
        save();
      })));

      // таймер
      const clock = $<HTMLOutputElement>('[data-clock]', root);
      const startBtn = $<HTMLButtonElement>('[data-start]', root);
      const total = Number(root.dataset.min) * 60;
      let left = total, timer = 0, running = false;
      const fmtT = (s: number) => `${s < 0 ? '−' : ''}${String(Math.floor(Math.abs(s) / 60)).padStart(2, '0')}:${String(Math.abs(s) % 60).padStart(2, '0')}`;
      const label = () => { if (startBtn) startBtn.innerHTML = `<span class="knob-i">${icon(running ? 'pause' : 'play')}</span><span>${running ? 'Пауза' : left < total ? 'Дальше' : 'Старт'}</span>`; };
      function setRun(on: boolean) {
        running = on;
        clearInterval(timer);
        if (on) timer = window.setInterval(() => {
          left--;
          if (clock) { clock.value = fmtT(left); clock.classList.toggle('warn', left <= 300 && left > 0); clock.classList.toggle('over', left <= 0); }
        }, 1000);
        label();
      }
      startBtn?.addEventListener('click', () => setRun(!running));

      function check(animate = true) {
        checked = true;
        setRun(false);
        const byPart = new Map<string, [number, number]>();
        let ok = 0;
        rows.forEach((row) => {
          const n = row.dataset.n!;
          const a = Number(row.dataset.a);
          const part = row.closest('fieldset')!.querySelector('legend')!.textContent || '';
          const mine = answers[n];
          const good = mine === a;
          if (good) ok++;
          const pr = byPart.get(part) || [0, 0];
          byPart.set(part, [pr[0] + (good ? 1 : 0), pr[1] + 1]);
          row.classList.toggle('ok', good);
          row.classList.toggle('bad', !good);
          row.classList.toggle('noans', mine === undefined);
          $$<HTMLButtonElement>('.sheet-opts button', row).forEach((b) => {
            const i = Number(b.dataset.i);
            b.disabled = true;
            b.classList.toggle('right', i === a);
            b.classList.toggle('wrong', i === mine && !good);
          });
          $('.sheet-why', row)!.hidden = false;
        });
        const raw = ok * factor;
        const points = Math.min(max, exactHalves ? raw : Math.round(raw));
        const verdict = passAt === null ? '' : points >= passAt ? `<span class="verdict ok">Сдано: ${num(points)} из ${max}, порог ${passAt}</span>` : `<span class="verdict bad">Не хватает ${num(passAt - points)} до порога ${passAt}</span>`;
        res.hidden = false;
        res.innerHTML =
          `<div class="total"><div class="big"><span data-total>${num(points)}</span><small> / ${max}</small></div>${verdict}</div>` +
          `<p class="x-note">Верных ответов: <b>${ok} из ${rows.length}</b>${factor !== 1 ? ` × ${num(factor)}` : ''}</p>` +
          `<div class="sheet-parts">${[...byPart].map(([p, [g, t]]) => `<span class="pill${g === t ? ' lime' : ''}">${p}: ${g}/${t}</span>`).join('')}</div>` +
          `<p class="x-note">Ошибки подсвечены. Под каждым заданием объяснение. Слабая часть = следующий гайд.</p>`;
        if (animate) {
          const tot = $<HTMLElement>('[data-total]', res)!;
          spring(res, 'n', points, (x) => (tot.textContent = num(exactHalves ? Math.round(x * 2) / 2 : Math.round(x))), { from: 0, response: 0.5, eps: 0.05 });
          pop($('.big', res), 0.8, 0.7);
          res.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
          try {
            const all = JSON.parse(localStorage.getItem('abres') || '{}');
            all[root.dataset.id!] = { title: root.dataset.title, level: root.dataset.level, module: root.dataset.module, points, max, at: Date.now() };
            localStorage.setItem('abres', JSON.stringify(all));
          } catch { /* ignore */ }
        }
        checkBtn.disabled = true;
        save();
      }
      checkBtn.addEventListener('click', () => {
        const missing = rows.length - Object.keys(answers).length;
        if (missing > 0 && !confirm(`Не отмечено ${missing}. Пустая клетка = 0 баллов. Проверить всё равно?`)) return;
        check();
      });

      $('[data-reset]', root)!.addEventListener('click', () => {
        if ((Object.keys(answers).length || checked) && !confirm('Стереть ответы и начать заново?')) return;
        answers = {};
        checked = false;
        rows.forEach((row) => {
          row.classList.remove('ok', 'bad', 'noans');
          $$<HTMLButtonElement>('.sheet-opts button', row).forEach((b) => { b.disabled = false; b.classList.remove('right', 'wrong'); });
          $('.sheet-why', row)!.hidden = true;
          paint(row);
        });
        res.hidden = true;
        checkBtn.disabled = false;
        setRun(false);
        left = total;
        if (clock) { clock.value = fmtT(left); clock.classList.remove('warn', 'over'); }
        label();
        updProg();
        save();
      });

      try {
        const s = JSON.parse(localStorage.getItem(key) || 'null');
        if (s) { answers = s.answers || {}; rows.forEach(paint); if (s.checked) check(false); }
      } catch { /* ignore */ }
      updProg();
    });
  });
</script>
