---
/* Квиз: вопрос, варианты строками как в iOS, объяснение, итог. */
interface Q {
  q: string;
  o: string[];
  c: number;
  x: string;
  /** Немецкая фраза, которую озвучить после ответа. */
  say?: string;
}
interface Props {
  questions: Q[];
  title?: string;
}
const { questions, title = 'Проверь себя' } = Astro.props;
---
<div class="ix quiz rv" data-quiz={JSON.stringify(questions)}>
  <div class="ix-h"><b><svg class="ic"><use href="#i-list-checks" /></svg>{title}</b><span class="cap" data-count>{questions.length} вопросов</span></div>
  <div data-stage aria-live="polite"><noscript><p>Для теста нужен JavaScript.</p></noscript></div>
</div>

<script>
  import { $, $$, fmt, icon, onReady, pop, say } from '../../scripts/lib';

  type Q = { q: string; o: string[]; c: number; x: string; say?: string };

  onReady(() => {
    $$('[data-quiz]').forEach((root) => {
      const Q: Q[] = JSON.parse(root.dataset.quiz || '[]');
      const stage = $('[data-stage]', root)!;
      let qi = 0;
      let res: boolean[] = [];
      const dots = () =>
        '<div class="dots" aria-hidden="true">' +
        Q.map((_, i) => `<i class="${res[i] === true ? 'ok' : res[i] === false ? 'bad' : i === qi ? 'cur' : ''}"></i>`).join('') +
        '</div>';

      function draw(focus = false) {
        const it = Q[qi];
        stage.innerHTML =
          dots() +
          `<p class="qn">Вопрос ${qi + 1} из ${Q.length}</p>` +
          `<p class="qq">${fmt(it.q).replace('___', '<u data-blank>___</u>')}</p>` +
          `<div class="qo" role="group">${it.o.map((o, i) => `<button type="button" data-i="${i}"><span class="rd"></span><span>${fmt(o)}</span></button>`).join('')}</div>` +
          `<div class="qx" data-x>${icon('brain')}<span>Выбери вариант. Не подглядывай.</span></div>`;
        $$<HTMLButtonElement>('.qo button', stage).forEach((b) => (b.onclick = () => answer(Number(b.dataset.i))));
        if (focus) $<HTMLButtonElement>('.qo button', stage)?.focus({ preventScroll: true });
      }

      function answer(i: number) {
        const it = Q[qi];
        const ok = i === it.c;
        res[qi] = ok;
        $$<HTMLButtonElement>('.qo button', stage).forEach((b) => {
          b.disabled = true;
          const k = Number(b.dataset.i);
          const rd = $('.rd', b)!;
          if (k === it.c) { b.classList.add('ok'); rd.innerHTML = icon('check'); pop(rd, 0.5, 0.55); }
          else if (k === i) { b.classList.add('bad'); rd.innerHTML = icon('x'); pop(rd, 0.5, 0.55); }
        });
        const blank = $('[data-blank]', stage);
        if (blank) blank.textContent = it.o[it.c];
        const qx = $('[data-x]', stage)!;
        qx.className = 'qx ' + (ok ? 'good' : 'bad');
        qx.innerHTML = `${icon(ok ? 'circle-check' : 'circle-x')}<span>${ok ? '<b>Верно.</b> ' : '<b>Мимо.</b> '}${fmt(it.x)}</span>`;
        if (it.say) say(it.say);
        $('.dots', stage)!.outerHTML = dots();
        const nb = document.createElement('button');
        nb.className = 'btn qnext';
        nb.type = 'button';
        nb.innerHTML = qi < Q.length - 1 ? `Дальше ${icon('arrow-right')}` : `Итог ${icon('trophy')}`;
        nb.onclick = () => { qi++; qi < Q.length ? draw(true) : done(); };
        stage.appendChild(nb);
        nb.focus({ preventScroll: true });
      }

      function done() {
        const s = res.filter(Boolean).length;
        const n = Q.length;
        const msg =
          s === n ? `${n} из ${n}. На экзамене так же. Серьёзно.` :
          s >= n - 2 ? 'Почти. Глянь, где ошибся. Там обычно и падают.' :
          'Нормально. Первый раз у всех так. Пролистай шпаргалку и попробуй ещё.';
        stage.innerHTML =
          dots() +
          `<div class="qres"><div class="big" data-big>${s}<small>/${n}</small></div><p>${msg}</p>` +
          `<div class="row-btns"><button type="button" class="btn gray" data-again>${icon('rotate-ccw')} Ещё раз</button></div></div>`;
        $<HTMLButtonElement>('[data-again]', stage)!.onclick = () => { qi = 0; res = []; draw(true); };
        pop($('[data-big]', stage), 0.6, 0.65);
      }

      draw();
    });
  });
</script>
