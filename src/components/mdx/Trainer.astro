---
/* Тренажёр Schreiben: таймер, счётчик слов, автопроверка формы текста под тип задания. */
interface Props {
  points: string[];
  mode?: 'informal' | 'forum' | 'formal';
  minutes?: number;
  target?: number;
  id?: string;
}
const { points, mode = 'informal', minutes = 20, target = 80, id = 'trainer' } = Astro.props;

const CHECKS: Record<string, { k: string; t: string; s: string }[]> = {
  informal: [
    { k: 'anrede', t: 'Обращение в начале', s: 'Liebe Anna, / Lieber Tom, / Hallo Ben,' },
    { k: 'gruss', t: 'Прощание в конце', s: 'Viele Grüße / Liebe Grüße + имя' },
    { k: 'du', t: 'Пишешь на «du»', s: 'du, dir, dich, dein…' },
    { k: 'vorschlag', t: 'Есть предложение встретиться', s: 'Hast du Lust…? / Wollen wir…?' },
    { k: 'konn', t: 'Минимум 3 связки', s: 'weil, denn, deshalb, aber, dann, außerdem…' },
    { k: 'len', t: `Объём не меньше ${Math.round(target * 0.875)} слов`, s: `Меньше ${Math.round(target / 2)} = 0 баллов за всю часть` },
  ],
  forum: [
    { k: 'meinung', t: 'Своё мнение прямым текстом', s: 'Meiner Meinung nach… / Ich finde, dass…' },
    { k: 'grund', t: 'Есть обоснование', s: 'weil / denn / deshalb' },
    { k: 'beispiel', t: 'Есть пример', s: 'zum Beispiel / z. B. / beispielsweise' },
    { k: 'konn', t: 'Минимум 3 связки', s: 'außerdem, aber, trotzdem, einerseits…' },
    { k: 'schluss', t: 'Есть вывод', s: 'Deshalb finde ich… / Alles in allem… / Insgesamt…' },
    { k: 'len', t: `Объём не меньше ${Math.round(target * 0.875)} слов`, s: `Меньше ${Math.round(target / 2)} = 0 баллов за всю часть` },
  ],
  formal: [
    { k: 'anredeF', t: 'Вежливое обращение', s: 'Sehr geehrte Frau … / Liebe Frau … / Guten Tag,' },
    { k: 'sie', t: 'Пишешь на «Sie»', s: 'Sie, Ihnen, Ihr…' },
    { k: 'nodu', t: 'Ни одного «du»', s: 'du/dir/dein в письме начальнику = минус' },
    { k: 'bitte', t: 'Извинение или просьба', s: 'Entschuldigen Sie… / Leider… / Könnten Sie…?' },
    { k: 'grussF', t: 'Вежливое прощание', s: 'Mit freundlichen Grüßen / Viele Grüße + имя' },
    { k: 'len', t: `Объём не меньше ${Math.round(target * 0.875)} слов`, s: `Меньше ${Math.round(target / 2)} = 0 баллов за всю часть` },
  ],
};
const checks = CHECKS[mode];
---
<div class="ix trainer rv" data-trainer data-mode={mode} data-min={minutes} data-target={target} data-id={id}>
  <div class="tr-top">
    <div class="tr-time">
      <output data-clock>{String(minutes).padStart(2, '0')}:00</output>
      <small>Старт сам, как начнёшь печатать</small>
    </div>
    <div class="tr-btns">
      <button class="btn" type="button" data-start><svg class="ic"><use href="#i-play" /></svg><span>Старт</span></button>
      <button class="btn gray" type="button" data-reset aria-label="Сбросить"><svg class="ic"><use href="#i-rotate-ccw" /></svg></button>
    </div>
  </div>

  <label>
    <span class="sr">Твой текст</span>
    <textarea data-text lang="de" spellcheck="false" autocapitalize="sentences" placeholder={mode === 'formal' ? 'Sehr geehrte Frau …,' : mode === 'forum' ? 'Ich finde, …' : 'Liebe Anna, …'}></textarea>
  </label>

  <div class="tr-meter">
    <div class="lbl"><span>Слов: <b data-words>0</b> из ~{target}</span><span data-hint>Цель: около {target}</span></div>
    <div class="tr" aria-hidden="true"><i data-fill></i></div>
  </div>

  <ul class="checks" aria-label="Автопроверка формы">
    {checks.map((c) => (
      <li data-chk={c.k}><span class="ck"><svg class="ic"><use href="#i-check" /></svg></span><div>{c.t}<small>{c.s}</small></div></li>
    ))}
  </ul>

  <div class="tr-pts" role="group" aria-label="Пункты задания">
    <b>Пункты задания. Отметь сам: смысл машина не проверит</b>
    {points.map((p) => <label><input type="checkbox" data-pt /> <span>{p}</span></label>)}
  </div>
  <p class="tr-out" data-out aria-live="polite"></p>
</div>

<script>
  import { $, $$, onReady, pop, spring } from '../../scripts/lib';

  // \b не видит умлауты, поэтому границы слова через \p{L}.
  const W = (alts: string) => new RegExp(`(?<!\\p{L})(${alts})(?!\\p{L})`, 'giu');
  const CONN = W('weil|denn|deshalb|deswegen|darum|dann|danach|aber|sondern|obwohl|trotzdem|außerdem|ausserdem|zuerst|zum schluss|leider|übrigens|dass|wenn|als|einerseits|andererseits|zum beispiel|außerdem|allerdings|jedoch');
  const test = (re: RegExp, t: string) => { re.lastIndex = 0; return re.test(t); };

  onReady(() => {
    $$('[data-trainer]').forEach((root) => {
      const ta = $<HTMLTextAreaElement>('[data-text]', root)!;
      const clock = $<HTMLOutputElement>('[data-clock]', root)!;
      const startBtn = $<HTMLButtonElement>('[data-start]', root)!;
      const fill = $<HTMLElement>('[data-fill]', root)!;
      const wordsEl = $('[data-words]', root)!;
      const hint = $('[data-hint]', root)!;
      const out = $('[data-out]', root)!;
      const mode = root.dataset.mode || 'informal';
      const total = Number(root.dataset.min) * 60;
      const target = Number(root.dataset.target);
      const key = `trainer:${root.dataset.id}`;
      let left = total, timer = 0, running = false;

      const fmtT = (s: number) => `${s < 0 ? '−' : ''}${String(Math.floor(Math.abs(s) / 60)).padStart(2, '0')}:${String(Math.abs(s) % 60).padStart(2, '0')}`;
      const label = (on: boolean) => {
        startBtn.innerHTML = `<svg class="ic"><use href="#i-${on ? 'pause' : 'play'}"/></svg><span>${on ? 'Пауза' : left < total ? 'Дальше' : 'Старт'}</span>`;
      };
      function tick() {
        left--;
        clock.value = fmtT(left);
        clock.classList.toggle('warn', left <= 180 && left > 0);
        clock.classList.toggle('over', left <= 0);
        if (left === 0) out.textContent = 'Время вышло. На экзамене ты бы уже переходил к следующей части. Допиши и посмотри, сколько не успел.';
      }
      function setRun(on: boolean) {
        running = on;
        clearInterval(timer);
        if (on) timer = window.setInterval(tick, 1000);
        label(on);
      }
      startBtn.addEventListener('click', () => setRun(!running));
      $('[data-reset]', root)!.addEventListener('click', () => {
        setRun(false);
        left = total;
        clock.value = fmtT(left);
        clock.classList.remove('warn', 'over');
        label(false);
        out.textContent = '';
      });

      function check() {
        const t = ta.value.trim();
        const n = t ? t.split(/\s+/).length : 0;
        wordsEl.textContent = String(n);
        const w = Math.min(100, (n / (target * 1.5)) * 100);
        spring(fill, 'w', w, (x) => (fill.style.width = `${x}%`), { response: 0.35 });
        fill.style.background = n < target / 2 ? 'var(--red)' : n < target * 0.875 ? 'var(--sun)' : n <= target * 1.4 ? 'var(--lime)' : 'var(--sun)';
        hint.textContent =
          n === 0 ? `Цель: около ${target}` :
          n < target / 2 ? 'Меньше половины. Это 0 баллов за часть' :
          n < target * 0.875 ? 'Ещё немного' :
          n <= target * 1.4 ? 'Объём в норме' : 'Многовато. Больше слов = больше ошибок';
        const lines = t.split('\n').map((x) => x.trim()).filter(Boolean);
        const first = (lines[0] || '').toLowerCase();
        const tail = lines.slice(-3).join(' ').toLowerCase();
        const low = t.toLowerCase();
        const conn = (t.match(CONN) || []).length;
        const res: Record<string, boolean> = {
          anrede: /^(liebe|lieber|hallo|hi|servus|grüß dich)\b/.test(first),
          gruss: /(viele|liebe|herzliche|beste) grüße|bis bald|bis dann|dein[e]?\s+\S+$|lg\b/.test(tail),
          du: test(W('du|dir|dich|dein|deine|deinen|deinem|deiner'), t),
          vorschlag: /(hast du (lust|zeit)|wollen wir|sollen wir|wie wäre es|wie wär's|wir könnten|lass uns|treffen wir uns|was hältst du|kommst du|können wir)/i.test(t),
          konn: conn >= 3,
          len: n >= target * 0.875,
          meinung: /(meiner meinung nach|ich finde|ich bin der meinung|ich denke|ich glaube|meines erachtens|für mich ist)/.test(low),
          grund: test(W('weil|denn|deshalb|deswegen|darum'), t),
          beispiel: /(zum beispiel|z\. ?b\.|beispielsweise)/.test(low),
          schluss: /(deshalb finde ich|alles in allem|insgesamt|zusammenfassend|zum schluss|abschließend)/.test(low),
          anredeF: /^(sehr geehrte|sehr geehrter|liebe frau|lieber herr|guten tag|hallo frau|hallo herr)/.test(first),
          sie: /(?<!\p{L})(Sie|Ihnen|Ihr|Ihre|Ihren|Ihrem|Ihrer)(?!\p{L})/u.test(t.replace(/^[^\n]*\n?/, '')),
          nodu: n > 5 && !test(W('du|dir|dich|dein|deine|deinen|deinem|deiner'), t),
          bitte: /(entschuldig|tut mir (sehr )?leid|leider|könnten sie|würden sie|bitte)/.test(low),
          grussF: /(mit freundlichen grüßen|freundliche grüße|viele grüße|beste grüße)/.test(tail),
        };
        $$<HTMLLIElement>('[data-chk]', root).forEach((li) => {
          const was = li.classList.contains('ok');
          const ok = !!res[li.dataset.chk || ''];
          li.classList.toggle('ok', ok);
          if (ok && !was) pop($('.ck', li), 0.5, 0.55);
        });
        void mode;
        try { localStorage.setItem(key, ta.value); } catch { /* приватный режим */ }
      }

      ta.addEventListener('input', () => {
        if (!running && left === total && ta.value.trim()) setRun(true);
        check();
      });
      try {
        const saved = localStorage.getItem(key);
        if (saved) { ta.value = saved; check(); }
      } catch { /* ignore */ }

      const pts = $$<HTMLInputElement>('[data-pt]', root);
      pts.forEach((p) =>
        p.addEventListener('change', () => {
          out.textContent = pts.every((x) => x.checked) ? 'Все пункты закрыты. Это главное условие для Erfüllung. Остальное уже шлифовка.' : '';
        }),
      );
    });
  });
</script>
