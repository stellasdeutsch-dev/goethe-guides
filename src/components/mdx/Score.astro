---
interface Item { name: string; pts: number; max: number; note?: string; color?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<div class="meters">
  {items.map((it) => (
    <div class="meter-row" style={`--w:${(it.pts / it.max) * 100}%;--c:${it.color ?? 'var(--ink)'}`}>
      <b>{it.name}</b>
      <span>{it.pts.toString().replace('.', ',')} / {it.max}</span>
      <i class="meter-track"><i></i></i>
      {it.note && <small>{it.note}</small>}
    </div>
  ))}
</div>
