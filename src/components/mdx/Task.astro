---
interface Props { title: string; time?: string; words?: string }
const { title, time, words } = Astro.props;
---
<figure class="task" lang="de">
  <figcaption>
    <b>{title}</b>
    <span>
      {time && <span class="pill"><svg class="ic"><use href="#i-timer" /></svg>{time}</span>}
      {words && <span class="pill"><svg class="ic"><use href="#i-pen-line" /></svg>{words}</span>}
    </span>
  </figcaption>
  <slot />
</figure>
