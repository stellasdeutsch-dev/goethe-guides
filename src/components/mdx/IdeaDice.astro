---
/* Кубики идей: выбираешь тип пункта, бросаешь кубик, получаешь готовую деталь.
   «Собрать письмо целиком» складывает черновик из случайных деталей. Ниже банк заготовок.
   set: brief — письмо другу (Teil 1), forum — пост в форуме (Teil 2), formell — письмо на Sie (Teil 3). */
import { IDEAS } from '../../data/ideas';
interface Props { set?: keyof typeof IDEAS }
const { set = 'brief' } = Astro.props;
const S = IDEAS[set];
const keys = Object.keys(S.dice);
const first = S.dice[keys[0]][0];
---
<div class="x dice" data-dice={JSON.stringify(S.dice)} data-build={JSON.stringify(S.build)}>
  <div class="x-h"><b><svg class="ic"><use href="#i-zap" /></svg>{S.title}</b><span class="x-cap">{S.cap}</span></div>
  <p class="dice-q">Какой пункт в задании?</p>
  <div class="chips" role="group" aria-label="Тип пункта">
    {keys.map((k, i) => <button type="button" class="chip" data-k={k} aria-pressed={i === 0 ? 'true' : 'false'}>{k}</button>)}
  </div>
  <div class="dice-out" data-out aria-live="polite">
    <button class="say" type="button" data-say={first[0]} aria-label="Озвучить"><svg><use href="#i-volume-2" /></svg></button>
    <div><span class="de" lang="de" data-de>{first[0]}</span><span class="ru" data-ru>{first[1]}</span></div>
  </div>
  <div class="dice-act">
    <button type="button" class="btn dark" data-roll><svg class="ic"><use href="#i-repeat" /></svg>Бросить ещё</button>
    <button type="button" class="btn" data-build-btn><svg class="ic"><use href="#i-zap" /></svg>Собрать письмо целиком</button>
  </div>
  <div class="dice-letter" data-letter hidden>
    <pre lang="de" data-text></pre>
    <div class="dice-meta"><span data-words></span><button type="button" class="btn sm" data-copy>Скопировать</button></div>
    <p class="x-note">Это черновик. Поменяй одну-две детали под своё задание, и он твой.</p>
  </div>
  <p class="x-note">{S.note}</p>

  <details class="bank">
    <summary>{S.bankTitle}</summary>
    {S.bank.map(([t, lines]) => (
      <div class="bank-it"><b>{t}</b>{lines.map((l) => <span class="de" lang="de">{l}</span>)}</div>
    ))}
  </details>
</div>

<style>
  .dice-q{margin:0 0 10px;font-weight:600}
  .dice .chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
  .dice .chip{min-height:40px;cursor:pointer}
  .dice .chip[aria-pressed="true"]{background:var(--ink);color:var(--lime)}
  .dice-out{display:flex;gap:12px;align-items:flex-start;padding:16px;border-radius:18px;background:#fff;box-shadow:inset 0 0 0 1px var(--ink-line);margin-bottom:12px}
  .dice-out div{display:flex;flex-direction:column;gap:4px}
  .dice-out .de{font-weight:700;font-size:17px}
  .dice-out .ru{color:var(--text-2);font-size:14px}
  .dice-act{display:flex;flex-wrap:wrap;gap:8px}
  .dice [data-roll]{background:var(--ink);color:var(--lime);box-shadow:none}
  .dice-letter{margin-top:14px;padding:16px;border-radius:18px;background:#fff;box-shadow:inset 0 0 0 1px var(--ink-line)}
  .dice-letter pre{margin:0;white-space:pre-wrap;font:16px/1.55 Georgia,serif;color:var(--ink)}
  .dice-meta{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px;font-size:14px;color:var(--text-2)}
  .bank{margin-top:16px}
  .bank summary{cursor:pointer;font-weight:700;min-height:44px;display:flex;align-items:center}
  .bank-it{display:flex;flex-direction:column;gap:2px;padding:10px 0;border-top:1px solid var(--ink-line)}
  .bank-it .de{font-size:15px}
</style>

<script>
  import { $, $$, onReady, pop } from '../../scripts/lib';
  type Build = { start: string[]; order: string[]; end: string[]; joinStart?: string };
  onReady(() => {
    $$('[data-dice]').forEach((root) => {
      const D: Record<string, [string, string][]> = JSON.parse(root.dataset.dice || '{}');
      const B: Build = JSON.parse(root.dataset.build || '{}');
      const any = (k: string) => D[k][Math.floor(Math.random() * D[k].length)][0];
      let k = Object.keys(D)[0];
      let last = 0;
      const show = (i: number) => {
        const [de, ru] = D[k][i];
        $('[data-de]', root)!.textContent = de;
        $('[data-ru]', root)!.textContent = ru;
        $('.dice-out .say', root)!.setAttribute('data-say', de);
        pop($('[data-out]', root));
        last = i;
      };
      const roll = () => {
        const n = D[k].length;
        let i = Math.floor(Math.random() * n);
        if (i === last) i = (i + 1) % n;
        show(i);
      };
      $$<HTMLButtonElement>('.chip', root).forEach((b) => (b.onclick = () => {
        $$('.chip', root).forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
        k = b.dataset.k!;
        last = -1;
        roll();
      }));
      $('[data-roll]', root)!.onclick = roll;

      // Сборка черновика: начало, по одной детали из каждого типа, конец.
      const box = $('[data-letter]', root)!;
      let text = '';
      $('[data-build-btn]', root)!.onclick = () => {
        const picks = B.order.map(any);
        text = B.joinStart !== undefined
          ? [...B.start, ...picks].join(B.joinStart)
          : [B.start[0], [...B.start.slice(1), ...picks].join(' '), ...B.end].join('\n');
        const words = text.split(/\s+/).filter((w) => /[A-Za-zÄÖÜäöüß]/.test(w)).length;
        $('[data-text]', box)!.textContent = text;
        $('[data-words]', box)!.textContent = `${words} слов`;
        $('[data-copy]', box)!.textContent = 'Скопировать';
        box.hidden = false;
        pop(box);
      };
      $('[data-copy]', root)!.onclick = async () => {
        try { await navigator.clipboard.writeText(text); $('[data-copy]', root)!.textContent = 'Скопировано'; } catch { /* буфер недоступен */ }
      };
    });
  });
</script>
