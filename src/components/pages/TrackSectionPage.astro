---
// Экран 4: одна часть экзамена на одном уровне. Короткий список гайдов по порядку.
import Base from '../../layouts/Base.astro';
import { EXAMS, sectionOf, type ExamId } from '../../data/exams';
import { url } from '../../data/site';
import { plural } from '../../lib/guides';
import { toItem, trackData, trackHref } from '../../lib/tracks';

interface Props { exam: ExamId; track: string; section: string }
const { exam, track: trackId, section } = Astro.props;
const EX = EXAMS[exam];
const { track, bySection } = await trackData(exam, trackId);
const s = sectionOf(exam, section)!;
const items = bySection[section].map(toItem);
const name = ['pruefung', 'probniki', 'grammatik'].includes(section) ? s.title : s.de;
const minutes = items.reduce((n, i) => n + i.minutes, 0);
---
<Base title={`${name} ${EX.full} ${track.label}: гайды | Stellas`} description={`${s.lede} ${items.length} ${plural(items.length, 'гайд', 'гайда', 'гайдов')} для ${EX.full} ${track.label}.`} tone="gray" exam={exam} trail={[{ label: EX.name, href: url(`${EX.base}/`) }, { label: track.label, href: trackHref(exam, track.id) }, { label: name }]}>
  <section class="wrap screen" data-list>
    <span class="tile big" style={`--c:${s.color};--ts:52px`}><svg class="ic"><use href={`#i-${s.icon}`} /></svg></span>
    <h1 class="display q-title">{name} <span class="grad">{track.label}</span></h1>
    <p class="q-sub">{s.lede}</p>
    <p class="q-meta">{items.length} {plural(items.length, 'гайд', 'гайда', 'гайдов')} · ≈ {minutes} мин. Читай по порядку.</p>

    <ol class="glist" role="list">
      {items.map((i, n) => (
        <li>
          <a class="gitem" href={i.href} data-href={i.href}>
            <span class="gitem-n" aria-hidden="true"><b>{n + 1}</b><svg class="ic"><use href="#i-check" /></svg></span>
            <span class="gitem-t">{i.title}</span>
            <small>{i.minutes} мин</small>
          </a>
        </li>
      ))}
    </ol>

    <a class="back" href={trackHref(exam, track.id)}><svg class="ic"><use href="#i-arrow-left" /></svg> Все шаги {EX.name} {track.label}</a>
  </section>
</Base>

<script>
  import { $$, onReady } from '../../scripts/lib';
  onReady(() => {
    let seen: string[] = [];
    try { seen = JSON.parse(localStorage.getItem('seen') || '[]'); } catch { /* ignore */ }
    $$<HTMLAnchorElement>('[data-href]').forEach((a) => {
      const done = seen.includes(a.dataset.href || '');
      a.classList.toggle('done', done);
      if (done) a.setAttribute('aria-label', `${a.textContent?.trim()} — прочитано`);
    });
  });
</script>
