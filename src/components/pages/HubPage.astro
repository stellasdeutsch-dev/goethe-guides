---
// Экран 2: выбор уровня. Один вопрос, одна сетка, одна подсказка.
import Base from '../../layouts/Base.astro';
import { EXAMS, type ExamId } from '../../data/exams';
import { LEVELS, SITE, url } from '../../data/site';
import { getGuides, guideHref, slugOf } from '../../lib/guides';
import { generalGuides, readyTracks, trackHref } from '../../lib/tracks';
interface Props { exam: ExamId }
const { exam } = Astro.props;
const EX = EXAMS[exam];
const all = await getGuides(exam);
const tracks = await readyTracks(exam);
const help = all.find((g) => `${g.data.section}/${slugOf(g)}` === EX.helpSlug);
const general = generalGuides(all).filter((g) => g !== help);
const range = tracks.length ? `${tracks[0].label}–${tracks[tracks.length - 1].label}` : '';
const desc = exam === 'goethe' ? SITE.description : `Бесплатная подготовка к ${EX.full}: формат, пробники с разбором и гайды по каждой части экзамена.`;
---
<Base title={`Подготовка к ${EX.full} ${range} бесплатно | Stellas`} description={desc} tone="gray" exam={exam} trail={[{ label: EX.name }]}>
  <section class="wrap screen" data-exam={exam}>
    <p class="eyebrow">{EX.full}</p>
    <h1 class="display q-title">Какой уровень <span class="grad">сдаёшь?</span></h1>

    <a class="resume" href="#" data-resume hidden><span>Продолжить</span> <b data-resume-l></b> <svg class="ic"><use href="#i-chevron-right" /></svg></a>

    <ul class="pick" role="list">
      {tracks.map((t, i) => (
        <li style={`--i:${i}`}>
          <a class="pick-tile" href={trackHref(exam, t.id)} data-track={t.id} data-label={t.label}>
            <span class="stairs" aria-hidden="true">{LEVELS.map((l) => <i class={t.levels.includes(l) ? 'on' : LEVELS.indexOf(l) < LEVELS.indexOf(t.levels[0]) ? 'past' : ''} />)}</span>
            <span class="pick-l">{t.label}</span>
            <span class="pick-t">{t.title}</span>
          </a>
        </li>
      ))}
    </ul>

    {(help || general.length > 0) && (
      <ul class="quiet" role="list">
        {help && <li><a href={guideHref(help)}>Не знаешь, какой уровень нужен? <svg class="ic"><use href="#i-chevron-right" /></svg></a></li>}
        {general.slice(0, 2).map((g) => <li><a href={guideHref(g)}>{g.data.title} <svg class="ic"><use href="#i-chevron-right" /></svg></a></li>)}
      </ul>
    )}
  </section>
</Base>

<script>
  import { $, onReady } from '../../scripts/lib';
  onReady(() => {
    // Возвращаемся туда, где человек был в прошлый раз.
    let last: { href: string; label: string } | null = null;
    try { last = JSON.parse(localStorage.getItem(`track:${$('[data-exam]')?.dataset.exam}`) || 'null'); } catch { /* ignore */ }
    const r = $<HTMLAnchorElement>('[data-resume]');
    if (r && last?.href) {
      r.href = last.href;
      $('[data-resume-l]')!.textContent = last.label;
      r.hidden = false;
    }
  });
</script>
