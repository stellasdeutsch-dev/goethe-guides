---
import Base from '../../layouts/Base.astro';
import type { Section } from '../../data/sections';
import { EXAMS, type ExamId } from '../../data/exams';
import { SITE, url } from '../../data/site';
import { getGuides, guideHref, levelLabels, plural, readingTime, slugOf } from '../../lib/guides';

interface Props { exam: ExamId; s: Section }
const { exam, s } = Astro.props;
const EX = EXAMS[exam];
const B = EX.base;
const guides = (await getGuides(exam)).filter((g) => g.data.section === s.id);
const published = new Set(guides.map(slugOf));
const soon = s.planned.filter((p) => !published.has(p.slug));
const title = ['pruefung', 'probniki', 'grammatik'].includes(s.id) || s.de === s.title ? s.title : `${s.de} · ${s.title}`;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: `Гайды ${EX.name}`, item: new URL(url(`${B}/`), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: title, item: new URL(url(`${B}/${s.id}/`), Astro.site).href },
    ],
  },
];
---
<Base title={`${title} ${EX.full}: гайды | Stellas`} description={`${s.lede} Бесплатные гайды по ${EX.full} от Stellas.`} active={s.id} jsonld={jsonld} tone="gray" exam={exam}>
  <section class="sec-hero">
    <div class="wrap">
      <ol class="crumbs">
        <li><a href={url(`${B}/`)}>Гайды {EX.name}</a></li>
        <li><svg class="ic"><use href="#i-chevron-right" /></svg></li>
        <li aria-current="page">{s.title}</li>
      </ol>
      <span class="tile" style={`--c:${s.color}`}><svg class="ic"><use href={`#i-${s.icon}`} /></svg></span>
      <h1 class="display">{['pruefung', 'probniki', 'grammatik'].includes(s.id) || s.de === s.title ? s.title : <>{s.de}. <span class="grad" style={`--g1:${s.color};--g2:var(--violet)`}>{s.title}.</span></>}</h1>
      <p class="lede">{s.lede}</p>
      <p style="margin:18px 0 0;color:var(--text-2);font-size:15px">{guides.length} {plural(guides.length, 'гайд готов', 'гайда готово', 'гайдов готово')}{soon.length ? ` · ${soon.length} в работе` : ''}</p>

      <div class="cards">
        {guides.map((g) => (
          <a class="card rv" href={guideHref(g)}>
            <div class="row-meta">{levelLabels(g.data.levels).map((l) => <span class="cap">{l}</span>)}<span><svg class="ic"><use href="#i-clock" /></svg> {readingTime(g.body)} мин</span></div>
            <h3>{g.data.title}</h3>
            <p>{g.data.description}</p>
            <span class="go">Читать <svg class="ic"><use href="#i-chevron-right" /></svg></span>
          </a>
        ))}
        {soon.map((p) =>
          p.href ? (
            <a class="card rv" href={p.href} rel="noopener" target="_blank">
              <div class="row-meta">{p.levels.map((l) => <span class="cap">{l}</span>)}<span>отдельный сайт</span></div>
              <h3>{p.title}</h3>
              <span class="go">Открыть <svg class="ic"><use href="#i-arrow-up-right" /></svg></span>
            </a>
          ) : (
            <div class="card soon">
              <div class="row-meta"><span class="cap">скоро</span></div>
              <h3>{p.title}</h3>
            </div>
          ),
        )}
      </div>
    </div>
  </section>
</Base>
