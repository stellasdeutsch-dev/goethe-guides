---
// Экран 3: уровень. Три шага, у каждого одно главное действие. Длинные списки живут на экране модуля.
import Base from '../../layouts/Base.astro';
import { EXAMS, sectionOf, type ExamId } from '../../data/exams';
import { url } from '../../data/site';
import { getGuides, plural, slugOf } from '../../lib/guides';
import { REG, toItem, trackData, trackHref } from '../../lib/tracks';

interface Props { exam: ExamId; track: string }
const { exam, track: trackId } = Astro.props;
const EX = EXAMS[exam];
const B = EX.base;
const { track, guides, bySection, modules } = await trackData(exam, trackId);
const reg = exam === 'goethe' ? (await getGuides(exam)).filter((g) => REG.includes(slugOf(g))) : [];
const name = `${EX.name} ${track.label}`;

const steps = [
  { id: 'pruefung', n: 1, title: 'Пойми формат', text: 'Части экзамена и баллы.' },
  { id: 'probniki', n: 2, title: 'Реши пробник', text: 'Узнаешь баллы и слабое место.' },
].filter((s) => bySection[s.id]);
const modN = steps.length + 1;
const all = guides.map(toItem);
const jsonld = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Подготовка к ${EX.full} ${track.label}`,
  itemListElement: all.map((i, n) => ({ '@type': 'ListItem', position: n + 1, url: new URL(i.href, Astro.site).href, name: i.title })),
}];
---
<Base title={`${name}: подготовка по шагам | Stellas`} description={`Как подготовиться к ${EX.full} ${track.label}: формат, официальный пробник с разбором и гайды по каждой части. ${all.length} бесплатных гайдов.`} jsonld={jsonld} tone="gray" exam={exam} trail={[{ label: EX.name, href: url(`${B}/`) }, { label: track.label }]}>
  <section class="wrap screen" data-track-home data-exam={exam} data-track={track.id} data-label={name} data-short={track.label} data-goethe={exam === 'goethe' ? track.label : undefined}>
    <h1 class="display q-title">{EX.name} <span class="grad">{track.label}</span></h1>
    <p class="q-sub">{track.text}</p>
    <div class="meter" data-meter hidden><span><i data-meter-bar></i></span><small data-meter-t></small></div>

    <ol class="steps3" role="list">
      {steps.map((s, si) => {
        const list = bySection[s.id].map(toItem);
        const main = list[0];
        return (
          <li class="step3" style={`--i:${si}`} data-step={s.id} data-hrefs={list.map((i) => i.href).join(' ')}>
            <span class="step3-n" aria-hidden="true">{s.n}</span>
            <div class="step3-b">
              <h2>{s.title}</h2>
              <p>{s.text}</p>
              <a class={`go-main${s.id === 'probniki' ? ' primary' : ''}`} href={main.href}>
                <span>{main.title}</span>
                <small>{main.minutes} мин</small>
              </a>
              {list.length > 1 && <a class="more" href={trackHref(exam, track.id, s.id)}>Ещё {list.length - 1} {plural(list.length - 1, 'гайд', 'гайда', 'гайдов')} <svg class="ic"><use href="#i-chevron-right" /></svg></a>}
            </div>
          </li>
        );
      })}
      {modules.length > 0 && (
        <li class="step3" style={`--i:${steps.length}`} data-step="modules">
          <span class="step3-n" aria-hidden="true">{modN}</span>
          <div class="step3-b">
            <h2>Тренируй части</h2>
            <p>Начни с самой слабой.</p>
            <ul class="mods" role="list">
              {modules.map((m, mi) => {
                const s = sectionOf(exam, m)!;
                const n = bySection[m].length;
                return (
                  <li style={`--j:${mi}`}>
                    <a class="mod" href={trackHref(exam, track.id, m)} data-mod={m} data-hrefs={bySection[m].map((g) => toItem(g).href).join(' ')}>
                      <span class="tile" style={`--c:${s.color};--ts:36px`}><svg class="ic"><use href={`#i-${s.icon}`} /></svg></span>
                      <b>{s.de}</b>
                      <small data-mod-meta>{n} {plural(n, 'гайд', 'гайда', 'гайдов')}</small>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        </li>
      )}
    </ol>

    <ul class="quiet" role="list">
      <li><a href={url(`${B}/plan/`)}>Есть дата экзамена? План по неделям <svg class="ic"><use href="#i-chevron-right" /></svg></a></li>
      {bySection.grammatik && <li><a href={trackHref(exam, track.id, 'grammatik')}>Грамматика для {track.label} <svg class="ic"><use href="#i-chevron-right" /></svg></a></li>}
      {reg.length > 0 && <li><a href={toItem(reg[0]).href}>Где сдавать и сколько стоит <svg class="ic"><use href="#i-chevron-right" /></svg></a></li>}
    </ul>
  </section>
</Base>

<script>
  import { $, $$, onReady } from '../../scripts/lib';
  onReady(() => {
    const root = $<HTMLElement>('[data-track-home]');
    if (!root) return;
    const { exam = '', track = '', label = '', short = '', goethe } = root.dataset;
    try { localStorage.setItem(`track:${exam}`, JSON.stringify({ id: track, short, href: location.pathname, label })); } catch { /* ignore */ }

    let seen: string[] = [];
    let res: Record<string, { level?: string; module?: string; points: number; max: number; at: number }> = {};
    try {
      seen = JSON.parse(localStorage.getItem('seen') || '[]');
      res = JSON.parse(localStorage.getItem('abres') || '{}');
    } catch { /* ignore */ }
    const hrefsOf = (el: HTMLElement) => (el.dataset.hrefs || '').split(' ').filter(Boolean);

    // Шаг готов, когда прочитан его главный гайд. Первый неготовый шаг подсвечиваем.
    const steps = $$<HTMLElement>('[data-step]');
    let now = false;
    steps.forEach((s) => {
      const hrefs = s.dataset.step === 'modules' ? $$<HTMLElement>('[data-mod]', s).flatMap(hrefsOf) : hrefsOf(s);
      const done = s.dataset.step !== 'modules' && seen.includes(hrefs[0]);
      s.classList.toggle('done', done);
      if (!done && !now) { s.classList.add('now'); now = true; }
    });

    // Прогресс по всем гайдам уровня.
    const allHrefs = [...new Set(steps.flatMap((s) => s.dataset.step === 'modules' ? $$<HTMLElement>('[data-mod]', s).flatMap(hrefsOf) : hrefsOf(s)))];
    const read = allHrefs.filter((h) => seen.includes(h)).length;
    if (read) {
      $('[data-meter]')!.hidden = false;
      const bar = $<HTMLElement>('[data-meter-bar]')!;
      requestAnimationFrame(() => requestAnimationFrame(() => { bar.style.width = `${Math.round((read / allHrefs.length) * 100)}%`; }));
      $('[data-meter-t]')!.textContent = `Прочитано ${read} из ${allHrefs.length}`;
    }

    // Последний результат пробника по модулю.
    const mine = (k: string, r: { level?: string }) => goethe ? !/^(telc|oesd)-/.test(k) && r.level === goethe : k.startsWith(`${exam}-${track}-`);
    $$<HTMLElement>('[data-mod]').forEach((m) => {
      const last = Object.entries(res).filter(([k, r]) => mine(k, r) && r.module === m.dataset.mod).map(([, r]) => r).sort((a, b) => b.at - a.at)[0];
      if (last) {
        const p = Math.round((last.points / last.max) * 100);
        const meta = $('[data-mod-meta]', m)!;
        meta.textContent = `Пробник: ${p}%`;
        m.classList.add(p >= 60 ? 'ok' : 'low');
      }
    });
  });
</script>
