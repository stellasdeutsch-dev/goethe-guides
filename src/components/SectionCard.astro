---
import type { Section } from '../data/sections';
import { url } from '../data/site';
import { guideHref, plural, slugOf, type Guide } from '../lib/guides';

interface Props {
  section: Section;
  guides: Guide[];
}
const { section: s, guides } = Astro.props;
const published = new Set(guides.map(slugOf));
const soon = s.planned.filter((p) => !published.has(p.slug));
const fresh = Date.now() - 1000 * 60 * 60 * 24 * 21;
const count = guides.length + soon.filter((p) => p.href).length;
---
<article class="sec rv" style={`--c:${s.color};--k:${s.ink}`} data-sec={s.id}>
  <header class="sec-h">
    <a href={url(`/ru/guides/${s.id}/`)}>
      <svg class="ic"><use href={`#i-${s.icon}`} /></svg>
      <h2>{s.title}</h2>
    </a>
    <small>{count ? `${count} ${plural(count, 'гайд', 'гайда', 'гайдов')}` : 'в работе'}</small>
  </header>
  <ul>
    {guides.map((g) => (
      <li data-levels={g.data.levels.join(' ')}>
        <a class="gl" href={guideHref(g)}>
          <span class="t">{g.data.title}{g.data.published.getTime() > fresh && <span class="new">new</span>}</span>
          <span class="lv">{g.data.levels.slice(0, 2).map((l) => <i>{l}</i>)}</span>
        </a>
      </li>
    ))}
    {soon.map((p) => (
      <li data-levels={p.levels.join(' ')}>
        {p.href ? (
          <a class="gl" href={p.href} rel="noopener" target="_blank">
            <span class="t">{p.title} <svg class="ic"><use href="#i-arrow-up-right" /></svg></span>
            <span class="lv">{p.levels.slice(0, 2).map((l) => <i>{l}</i>)}</span>
          </a>
        ) : (
          <span class="gl soon" title="Скоро">
            <span class="t">{p.title} · скоро</span>
            <span class="lv">{p.levels.length > 2 ? <i>A1–C2</i> : p.levels.map((l) => <i>{l}</i>)}</span>
          </span>
        )}
      </li>
    ))}
    <li class="nolvl">Для этого уровня пока пусто. Пишу.</li>
  </ul>
  <a class="more" href={url(`/ru/guides/${s.id}/`)}>Весь раздел <svg class="ic"><use href="#i-arrow-right" /></svg></a>
</article>
