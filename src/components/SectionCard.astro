---
import type { Section } from '../data/sections';
import { url } from '../data/site';
import { guideHref, plural, slugOf, type Guide } from '../lib/guides';

interface Props {
  section: Section;
  guides: Guide[];
}
const { section: s, guides } = Astro.props;
const published = new Set(guides.map(slugOf));
const soon = s.planned.filter((p) => !published.has(p.slug));
const fresh = Date.now() - 1000 * 60 * 60 * 24 * 21;
const count = guides.length + soon.filter((p) => p.href).length;
const lv = (levels: string[]) => (levels.length > 2 ? ['A1–C2'] : levels);
---
<section class="group rv" data-sec={s.id} id={`g-${s.id}`}>
  <div class="group-h">
    <span class="tile" style={`--c:${s.color}`}><svg class="ic"><use href={`#i-${s.icon}`} /></svg></span>
    <h2><a href={url(`/ru/guides/${s.id}/`)}>{s.title}</a></h2>
    <small>{count ? `${count} ${plural(count, 'гайд', 'гайда', 'гайдов')}` : 'скоро'}</small>
  </div>
  <ul class="list">
    {guides.map((g) => (
      <li data-levels={g.data.levels.join(' ')}>
        <a class="row" href={guideHref(g)}>
          <span class="t">{g.data.title}{g.data.published.getTime() > fresh && <span class="cap blue new">Новое</span>}</span>
          <span class="lv">{lv(g.data.levels).map((l) => <span class="cap">{l}</span>)}</span>
          <svg class="ic chev"><use href="#i-chevron-right" /></svg>
        </a>
      </li>
    ))}
    {soon.map((p) => (
      <li data-levels={p.levels.join(' ')}>
        {p.href ? (
          <a class="row" href={p.href} rel="noopener" target="_blank">
            <span class="t">{p.title}</span>
            <span class="lv">{lv(p.levels).map((l) => <span class="cap">{l}</span>)}</span>
            <svg class="ic chev"><use href="#i-arrow-up-right" /></svg>
          </a>
        ) : (
          <span class="row soon">
            <span class="t">{p.title}</span>
            <span class="cap">скоро</span>
          </span>
        )}
      </li>
    ))}
  </ul>
  <p class="nolvl">Для этого уровня пока пусто. Пишу.</p>
</section>
