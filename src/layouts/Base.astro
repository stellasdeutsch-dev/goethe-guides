---
import '../styles/global.css';
import '../styles/flow.css';
import sprite from '../assets/sprite.svg?raw';
import { SITE, url } from '../data/site';
import { EXAMS, EXAM_IDS, type ExamId } from '../data/exams';
import { getGuides } from '../lib/guides';

export interface Crumb { label: string; href?: string }
interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  jsonld?: object[];
  /** gray = серая подложка, white = статья. */
  tone?: 'gray' | 'white';
  noindex?: boolean;
  exam?: ExamId;
  /** Где человек сейчас: экзамен › уровень › модуль. Это и есть вся навигация. */
  trail?: Crumb[];
}
const { title, description, ogType = 'website', jsonld = [], tone = 'white', noindex = false, exam = 'goethe', trail = [] } = Astro.props;
const readyExams: ExamId[] = [];
for (const e of EXAM_IDS) if ((await getGuides(e)).length) readyExams.push(e);
const home = url(readyExams.length > 1 ? '/ru/' : `${EXAMS[exam].base}/`);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url('/og.png'), Astro.site).href;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="color-scheme" content="light" />
  <meta name="theme-color" content="#F0EFEB" />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={url('/logo.webp')} />
  <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/ru/guides/rss.xml')} />
  <link rel="sitemap" href={url('/sitemap-index.xml')} />
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body class={`tone-${tone}`}>
  <a class="skip" href="#main">К содержанию</a>
  <Fragment set:html={sprite} />

  <header class="gnav">
    <div class="wrap">
      <a class="brand" href={home} aria-label="Stellas: на главную">
        <img src={url('/favicon.svg')} alt="" width="30" height="30" />
        <span class="brand-t">Stellas</span>
      </a>
      {trail.length > 0 && (
        <nav class="trail" aria-label="Где ты сейчас">
          <ol>
            {trail.map((c, i) => (
              <li>
                {i > 0 && <svg class="ic" aria-hidden="true"><use href="#i-chevron-right" /></svg>}
                {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
              </li>
            ))}
          </ol>
        </nav>
      )}
    </div>
    <div class="prog" aria-hidden="true"></div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="foot2">
    <div class="wrap">
      <span>© {new Date().getFullYear()} Stellas</span>
      <a href={SITE.telegram} rel="noopener" target="_blank">Telegram</a>
      <a href={SITE.platform} rel="noopener" target="_blank">Платформа Stellas</a>
      <small>Сайт не связан с Goethe-Institut, telc gGmbH и ÖSD. Формат заданий сверяем с официальными материалами.</small>
    </div>
  </footer>

  <script>
    import '../scripts/site.ts';
  </script>
</body>
</html>
