---
import '../styles/global.css';
import sprite from '../assets/sprite.svg?raw';
import { SITE, url } from '../data/site';
import { SECTIONS } from '../data/sections';

interface Props {
  title: string;
  description: string;
  /** Активный раздел: id раздела или 'all'. */
  active?: string;
  ogType?: 'website' | 'article';
  jsonld?: object[];
  /** gray = серая подложка (хабы), white = статья. */
  tone?: 'gray' | 'white';
  noindex?: boolean;
}
const { title, description, active, ogType = 'website', jsonld = [], tone = 'white', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url('/og.png'), Astro.site).href;
const short = (id: string) => ({ pruefung: 'Об экзамене', grammatik: 'Грамматика' })[id] ?? SECTIONS.find((s) => s.id === id)!.de;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={url('/logo.webp')} />
  <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/ru/guides/rss.xml')} />
  <link rel="sitemap" href={url('/sitemap-index.xml')} />
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="ru_RU" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body class={`tone-${tone}`}>
  <a class="skip" href="#main">К содержанию</a>
  <Fragment set:html={sprite} />

  <header class="gnav">
    <div class="wrap">
      <a class="brand" href={url('/ru/guides/')}>
        <img src={url('/logo.webp')} alt="" width="26" height="26" />
        Stellas <span>Goethe</span>
      </a>
      <nav aria-label="Разделы">
        {SECTIONS.map((s) => (
          <a href={url(`/ru/guides/${s.id}/`)} aria-current={active === s.id ? 'page' : undefined}>{short(s.id)}</a>
        ))}
      </nav>
      <div class="right">
        <a class="btn sm" href={SITE.platform} rel="noopener" target="_blank">Платформа</a>
        <button class="menu-btn" type="button" aria-label="Меню" aria-expanded="false" aria-controls="sheet"><svg class="ic"><use href="#i-menu" /></svg></button>
      </div>
    </div>
    <div class="prog" aria-hidden="true"></div>
  </header>
  <div class="sheet" id="sheet" inert>
    <a href={url('/ru/guides/')}><span class="tile" style="--c:var(--text-3)"><svg class="ic"><use href="#i-book-open" /></svg></span>Все гайды</a>
    {SECTIONS.map((s) => (
      <a href={url(`/ru/guides/${s.id}/`)}><span class="tile" style={`--c:${s.color}`}><svg class="ic"><use href={`#i-${s.icon}`} /></svg></span>{s.title}</a>
    ))}
    <a href={SITE.telegram} rel="noopener" target="_blank"><span class="tile" style="--c:var(--deep)"><svg class="ic"><use href="#i-send" /></svg></span>Telegram</a>
  </div>
  <div class="scrim" aria-hidden="true"></div>

  <main id="main">
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap">
      <div class="grid">
        <div>
          <h3>Stellas · Goethe</h3>
          <p>Бесплатные гайды по Goethe-Zertifikat. Пишу как человек, который сам учит немецкий. Без воды и без «уважаемых студентов».</p>
        </div>
        <div>
          <h3>Разделы</h3>
          <ul>{SECTIONS.map((s) => <li><a href={url(`/ru/guides/${s.id}/`)}>{s.title}</a></li>)}</ul>
        </div>
        <div>
          <h3>Ещё</h3>
          <ul>
            <li><a href={SITE.telegram} rel="noopener" target="_blank">Telegram @stellasdeutsch</a></li>
            <li><a href={SITE.platform} rel="noopener" target="_blank">Платформа Stellas A0–C1</a></li>
            <li><a href={url('/ru/guides/rss.xml')}>RSS</a></li>
          </ul>
        </div>
      </div>
      <div class="fine">
        <span>Сайт не связан с Goethe-Institut e.V. Goethe-Zertifikat — экзамен Goethe-Institut. Формат заданий сверяем с официальными материалами на goethe.de.</span>
        <span>© {new Date().getFullYear()} Stellas · {SITE.author.name}</span>
      </div>
    </div>
  </footer>

  <script>
    import '../scripts/site.ts';
  </script>
</body>
</html>
