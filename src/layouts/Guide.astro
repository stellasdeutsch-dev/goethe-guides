---
import '../styles/guide.css';
import Base from './Base.astro';
import { EXAMS, sectionOf } from '../data/exams';
import { SITE, url } from '../data/site';
import { guideHref, levelLabels, plural, readingTime, ruDate, slugOf, type Guide } from '../lib/guides';
import { toItem, trackData, trackHref, trackIdsOf } from '../lib/tracks';
import type { MarkdownHeading } from 'astro';

interface Props {
  entry: Guide;
  headings: MarkdownHeading[];
}
const { entry, headings } = Astro.props;
const d = entry.data;
const EX = EXAMS[d.exam];
const B = EX.base;
const s = sectionOf(d.exam, d.section)!;
const minutes = readingTime(entry.body);
// Трек по умолчанию: первый подходящий уровень. Скрипт ниже подменит его на тот, что человек выбрал сам.
const tracks = trackIdsOf(entry);
const primary = tracks.length ? await trackData(d.exam, tracks[0]) : null;
const modName = ['pruefung', 'probniki', 'grammatik'].includes(s.id) ? s.title : s.de;
const trail = [
  { label: EX.name, href: url(`${B}/`) },
  ...(primary ? [{ label: primary.track.label, href: trackHref(d.exam, primary.track.id) }, { label: modName, href: trackHref(d.exam, primary.track.id, s.id) }] : []),
];
// Следующий гайд: дальше по списку модуля, потом первый гайд следующего шага, иначе назад к шагам.
let next: { title: string; href: string; minutes?: number; kicker: string } | null = null;
if (primary) {
  const order = ['pruefung', 'probniki', ...primary.modules];
  const list = (primary.bySection[s.id] ?? []).map(toItem);
  const i = list.findIndex((x) => x.slug === slugOf(entry));
  if (i >= 0 && i < list.length - 1) next = { ...list[i + 1], kicker: `Дальше в ${modName}` };
  else {
    const after = order.slice(order.indexOf(s.id) + 1).find((id) => primary.bySection[id]);
    if (after) {
      const n = toItem(primary.bySection[after][0]);
      const ns = sectionOf(d.exam, after)!;
      next = { ...n, kicker: `Следующий шаг: ${['pruefung', 'probniki'].includes(after) ? ns.title : ns.de}` };
    } else next = { title: `Все шаги ${EX.name} ${primary.track.label}`, href: trackHref(d.exam, primary.track.id), kicker: 'Модуль пройден' };
  }
}
const toc = headings.filter((h) => h.depth === 2);
const href = new URL(guideHref(entry), Astro.site).href;
const logo = new URL(url('/logo.webp'), Astro.site).href;

// Заголовок с плашкой .hl на нужном куске.
const [before, after] = d.hl && d.title.includes(d.hl) ? d.title.split(d.hl) : [d.title, undefined];

const jsonld: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    inLanguage: 'ru',
    datePublished: d.published.toISOString(),
    dateModified: d.updated.toISOString(),
    author: { '@type': 'Organization', name: 'Stellas', url: SITE.author.telegram },
    publisher: { '@type': 'Organization', name: 'Stellas', logo: { '@type': 'ImageObject', url: logo } },
    mainEntityOfPage: href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: `Гайды ${EX.name}`, item: new URL(url(`${B}/`), Astro.site).href },
      ...trail.slice(1).map((c, i) => ({ '@type': 'ListItem', position: i + 2, name: c.label, item: new URL(c.href, Astro.site).href })),
      { '@type': 'ListItem', position: trail.length + 1, name: d.title, item: href },
    ],
  },
];
if (d.faq.length) {
  jsonld.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---
<Base title={d.seoTitle} description={d.description} ogType="article" jsonld={jsonld} exam={d.exam} trail={trail}>
  <article class="wrap read" style={`--sc:${s.color}`} data-guide data-exam={d.exam} data-tracks={tracks.join(' ')} data-primary={primary?.track.id ?? ''}>
    <div class="paper">
    <header class="g-head">
      <h1 class="g-title" data-pagefind-meta="title">
        {after !== undefined ? <>{before}<span class="hl" style={`--g1:${s.color};--g2:var(--violet)`}>{d.hl}</span>{after}</> : d.title}
      </h1>
      <p class="lede">{d.lede ?? d.description}</p>
      <p class="g-meta">{minutes} мин · {levelLabels(d.levels).join(', ')} · {SITE.author.name} · обновлено {ruDate(d.updated)}</p>
      <aside class="kurz" aria-labelledby="kurz-h">
        <h2 id="kurz-h"><svg class="ic"><use href="#i-sparkles" /></svg>Коротко</h2>
        <ul>{d.kurz.map((k) => <li set:html={k} />)}</ul>
      </aside>
      {toc.length > 2 && (
        <details class="toc mob">
          <summary>Содержание · {toc.length} {plural(toc.length, 'раздел', 'раздела', 'разделов')} <svg class="ic"><use href="#i-chevron-down" /></svg></summary>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      )}
    </header>

    <div class="prose" data-pagefind-body>
      <slot />

      {d.faq.length > 0 && (
        <>
          <h2 id="faq">Частые вопросы</h2>
          <div class="faq">
            {d.faq.map((f) => (
              <details>
                <summary>{f.q} <svg class="ic"><use href="#i-plus" /></svg></summary>
                <div class="a" set:html={f.a} />
              </details>
            ))}
          </div>
        </>
      )}
    </div>
    </div>

    {next && (
      <a class="next1" href={next.href}>
        <small>{next.kicker}</small>
        <b>{next.title}</b>
        <span class="next1-go">{next.minutes ? `${next.minutes} мин` : 'Открыть'} <svg class="ic"><use href="#i-arrow-right" /></svg></span>
      </a>
    )}

    <section class="cta-st" aria-labelledby="cta-h">
      <h2 id="cta-h">Грамматика и слова для экзамена</h2>
      <p>На платформе Stellas 340+ уроков A0–C1 с озвучкой. Один платёж, доступ навсегда.</p>
      <a class="btn" href={SITE.platform} rel="noopener" target="_blank">Посмотреть платформу</a>
    </section>

    {d.sources.length > 0 && (
      <details class="sources">
        <summary>Источники · {d.sources.length}</summary>
        <ol>{d.sources.map((x) => <li><a href={x.url} rel="noopener" target="_blank">{x.title}</a></li>)}</ol>
      </details>
    )}
  </article>
</Base>

<script>
  import { $, $$, onReady } from '../scripts/lib';
  onReady(() => {
    // Если человек выбрал другой уровень, а гайд подходит и ему, ведём хлебные крошки туда.
    const a = $<HTMLElement>('[data-guide]');
    if (!a?.dataset.primary) return;
    let last: { id?: string; short?: string } | null = null;
    try { last = JSON.parse(localStorage.getItem(`track:${a.dataset.exam}`) || 'null'); } catch { /* ignore */ }
    const tracks = (a.dataset.tracks || '').split(' ');
    if (!last?.id || last.id === a.dataset.primary || !tracks.includes(last.id)) return;
    const from = `/uroven/${a.dataset.primary}/`;
    $$<HTMLAnchorElement>('.trail a').forEach((x, i) => {
      if (!x.href.includes(from)) return;
      x.href = x.href.replace(from, `/uroven/${last!.id}/`);
      if (i === 1 && last!.short) x.textContent = last!.short;
    });
  });
</script>
