---
// Корень сайта сразу ведёт к выбору: экзамен, или уровень, если экзамен пока один.
import { url } from '../data/site';
import { EXAMS, EXAM_IDS, type ExamId } from '../data/exams';
import { getGuides } from '../lib/guides';
const ready: ExamId[] = [];
for (const e of EXAM_IDS) if ((await getGuides(e)).length) ready.push(e);
const to = url(ready.length === 1 ? `${EXAMS[ready[0]].base}/` : '/ru/');
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <title>Stellas: подготовка к экзаменам по немецкому</title>
  <meta http-equiv="refresh" content={`0; url=${to}`} />
  <link rel="canonical" href={new URL(to, Astro.site).href} />
  <meta name="robots" content="noindex" />
</head>
<body style="background:#F1F5FB"><a href={to}>Открыть</a></body>
</html>
