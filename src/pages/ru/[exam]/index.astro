---
import LevelPick from '../../../components/screens/LevelPick.astro';
import { getGuides } from '../../../lib/guides';
import { OTHER_EXAMS, type ExamId } from '../../../data/exams';
export async function getStaticPaths() {
  const out = [];
  for (const exam of OTHER_EXAMS) if ((await getGuides(exam)).length) out.push({ params: { exam }, props: { exam } });
  return out;
}
const { exam } = Astro.props as { exam: ExamId };
---
<LevelPick exam={exam} />
