---
import SectionPage from '../../../../components/pages/SectionPage.astro';
import { EXAMS, type ExamId } from '../../../../data/exams';
import type { Section } from '../../../../data/sections';
import { getGuides } from '../../../../lib/guides';

export async function getStaticPaths() {
  const out = [];
  for (const exam of ['telc', 'oesd'] as ExamId[]) {
    const all = await getGuides(exam);
    for (const s of EXAMS[exam].sections) if (all.some((g) => g.data.section === s.id)) out.push({ params: { exam, section: s.id }, props: { exam, s } });
  }
  return out;
}
const { exam, s } = Astro.props as { exam: ExamId; s: Section };
---
<SectionPage exam={exam} s={s} />
