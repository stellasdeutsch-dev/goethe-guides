---
import ModuleList from '../../../../../components/screens/ModuleList.astro';
import { readyTracks, trackData } from '../../../../../lib/tracks';
import type { ExamId } from '../../../../../data/exams';
export async function getStaticPaths() {
  const out = [];
  for (const exam of ['telc', 'oesd'] as ExamId[]) {
    for (const t of await readyTracks(exam)) {
      const { bySection } = await trackData(exam, t.id);
      for (const section of Object.keys(bySection)) out.push({ params: { exam, level: t.id, section }, props: { exam, track: t.id, section } });
    }
  }
  return out;
}
const { exam, track, section } = Astro.props as { exam: ExamId; track: string; section: string };
---
<ModuleList exam={exam} track={track} section={section} />
