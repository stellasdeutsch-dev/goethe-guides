---
import LevelHome from '../../../../components/screens/LevelHome.astro';
import { readyTracks } from '../../../../lib/tracks';
import type { ExamId } from '../../../../data/exams';
export async function getStaticPaths() {
  const out = [];
  for (const exam of ['telc', 'oesd'] as ExamId[]) for (const t of await readyTracks(exam)) out.push({ params: { exam, level: t.id }, props: { exam, track: t.id } });
  return out;
}
const { exam, track } = Astro.props as { exam: ExamId; track: string };
---
<LevelHome exam={exam} track={track} />
