---
import Plan from '../../../components/screens/Plan.astro';
import { getGuides } from '../../../lib/guides';
import type { ExamId } from '../../../data/exams';
export async function getStaticPaths() {
  const out = [];
  for (const exam of ['telc', 'oesd'] as ExamId[]) if ((await getGuides(exam)).length) out.push({ params: { exam }, props: { exam } });
  return out;
}
const { exam } = Astro.props as { exam: ExamId };
---
<Plan exam={exam} />
