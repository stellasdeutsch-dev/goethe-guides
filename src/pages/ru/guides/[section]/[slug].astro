---
import { render } from 'astro:content';
import Article from '../../../../layouts/Article.astro';
import Table from '../../../../components/mdx/Table.astro';
import { getGuides, slugOf, type Guide } from '../../../../lib/guides';
export async function getStaticPaths() {
  return (await getGuides('goethe')).map((entry) => ({ params: { section: entry.data.section, slug: slugOf(entry) }, props: { entry } }));
}
const { entry } = Astro.props as { entry: Guide };
const { Content, headings } = await render(entry);
---
<Article entry={entry} headings={headings}><Content components={{ table: Table }} /></Article>
