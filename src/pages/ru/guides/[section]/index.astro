---
import SectionPick from '../../../../components/screens/SectionPick.astro';
import { sectionsWithTracks } from '../../../../lib/tracks';
export async function getStaticPaths() {
  return (await sectionsWithTracks('goethe')).map((section) => ({ params: { section }, props: { section } }));
}
const { section } = Astro.props as { section: string };
---
<SectionPick exam="goethe" section={section} />
