---
import SectionPage from '../../../../components/pages/SectionPage.astro';
import { EXAMS } from '../../../../data/exams';
import type { Section } from '../../../../data/sections';

export function getStaticPaths() {
  return EXAMS.goethe.sections.map((s) => ({ params: { section: s.id }, props: { s } }));
}
const { s } = Astro.props as { s: Section };
---
<SectionPage exam="goethe" s={s} />
