---
import Base from '../../../../layouts/Base.astro';
import { SECTIONS, type Section } from '../../../../data/sections';
import { SITE, url } from '../../../../data/site';
import { getGuides, guideHref, plural, readingTime, slugOf } from '../../../../lib/guides';

export function getStaticPaths() {
  return SECTIONS.map((s) => ({ params: { section: s.id }, props: { s } }));
}
const { s } = Astro.props as { s: Section };
const guides = (await getGuides()).filter((g) => g.data.section === s.id);
const published = new Set(guides.map(slugOf));
const soon = s.planned.filter((p) => !published.has(p.slug));
const title = s.id === 'pruefung' || s.id === 'grammatik' ? s.title : `${s.de} · ${s.title}`;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Гайды', item: new URL(url('/ru/guides/'), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: title, item: new URL(url(`/ru/guides/${s.id}/`), Astro.site).href },
    ],
  },
];
---
<Base title={`${title} Goethe-Zertifikat: гайды | Stellas`} description={`${s.lede} Гайды по Goethe-Zertifikat от ${SITE.author.name}.`} active={s.id} jsonld={jsonld} gsap>
  <section class="sec-hero" style={`--c:${s.color};--k:${s.ink}`}>
    <div class="wrap">
      <ol class="crumbs">
        <li><a href={url('/ru/guides/')}>Гайды</a></li>
        <li><svg class="ic"><use href="#i-chevron-right" /></svg></li>
        <li aria-current="page">{s.title}</li>
      </ol>
      <p style="margin-top:22px"><span class="tag"><svg class="ic"><use href={`#i-${s.icon}`} /></svg> {s.de}</span></p>
      <h1 class="mega">{s.id === 'pruefung' || s.id === 'grammatik' ? s.title : <>{s.de} <span class="hl" style={`background:${s.color};color:${s.ink}`}>{s.title}</span></>}</h1>
      <p class="lede">{s.lede}</p>
      <p class="eyebrow" style="margin-top:22px">{guides.length} {plural(guides.length, 'гайд готов', 'гайда готово', 'гайдов готово')} · {soon.length} в работе</p>

      <div class="cards">
        {guides.map((g) => (
          <a class="card rv" href={guideHref(g)} style={`--c:${s.color}`}>
            <div class="row">{g.data.levels.map((l) => <span class="pill solid">{l}</span>)}<span><svg class="ic"><use href="#i-clock" /></svg> {readingTime(g.body)} мин</span></div>
            <h3>{g.data.title}</h3>
            <p>{g.data.description}</p>
          </a>
        ))}
        {soon.map((p) =>
          p.href ? (
            <a class="card rv" href={p.href} rel="noopener" target="_blank" style={`--c:${s.color}`}>
              <div class="row">{p.levels.map((l) => <span class="pill solid">{l}</span>)}<span>отдельный сайт <svg class="ic"><use href="#i-arrow-up-right" /></svg></span></div>
              <h3>{p.title}</h3>
            </a>
          ) : (
            <div class="card soon">
              <div class="row">{p.levels.length > 2 ? <span class="pill">A1–C2</span> : p.levels.map((l) => <span class="pill">{l}</span>)}<span>скоро</span></div>
              <h3>{p.title}</h3>
            </div>
          ),
        )}
      </div>
    </div>
  </section>
</Base>
