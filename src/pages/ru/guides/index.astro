---
import Base from '../../../layouts/Base.astro';
import SectionCard from '../../../components/SectionCard.astro';
import { SECTIONS } from '../../../data/sections';
import { LEVELS, SITE, url } from '../../../data/site';
import { getGuides, guideHref } from '../../../lib/guides';

const guides = await getGuides();
const pageUrl = new URL(url('/ru/guides/'), Astro.site).href;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: SITE.title,
    description: SITE.description,
    url: pageUrl,
    inLanguage: 'ru',
    hasPart: guides.map((g) => ({
      '@type': 'Article',
      headline: g.data.title,
      url: new URL(guideHref(g), Astro.site).href,
    })),
  },
];
const words = ['Lesen', 'Hören', 'Schreiben', 'Sprechen', 'A1', 'B1', 'B2', 'C1'];
---
<Base title="Гайды по Goethe-Zertifikat A1–C2 — бесплатно | Stellas" description={SITE.description} active="all" jsonld={jsonld} gsap>
  <section class="hub-hero">
    <div class="sun" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow"><svg class="burst spin"><use href="#b" /></svg> Гайды · Goethe-Zertifikat A1–C2</p>
      <h1 class="mega">Гайды по <span class="hl">Goethe</span></h1>
      <p class="lede">Учу немецкий в Австрии. Разбираю Goethe так, как хотел бы, чтобы разобрали мне. Формат. Ловушки. Тренажёры. Без воды.</p>
      <div class="metarow">
        <div><small><svg class="ic"><use href="#i-layers" /></svg> Модули</small><b>4: Lesen, Hören, Schreiben, Sprechen</b></div>
        <div><small><svg class="ic"><use href="#i-target" /></svg> Проходной B1</small><b>60 из 100 на модуль</b></div>
        <div><small><svg class="ic"><use href="#i-graduation-cap" /></svg> Уровни</small><b>A1–C2, старт с B1</b></div>
        <div><small><svg class="ic"><use href="#i-sparkles" /></svg> Цена</small><b>Бесплатно</b></div>
      </div>
    </div>
  </section>

  <div class="band" aria-hidden="true">
    <div class="track">
      {[0, 1].map(() => (
        <span>{words.map((w) => <>{w} <svg class="burst"><use href="#b" /></svg></>)}</span>
      ))}
    </div>
  </div>

  <section class="wrap" aria-label="Поиск и разделы">
    <div class="finder">
      <label class="search">
        <span class="sr">Поиск по гайдам</span>
        <svg class="ic"><use href="#i-search" /></svg>
        <input id="q" type="search" placeholder="Поиск, например «письмо другу» или Redemittel" autocomplete="off" />
      </label>
      <div class="results" id="res" aria-live="polite"></div>
      <div class="lvls" role="group" aria-label="Фильтр по уровню">
        <small>Уровень</small>
        <button class="lvl" type="button" data-lvl="" aria-pressed="true">Все</button>
        {LEVELS.map((l) => <button class="lvl" type="button" data-lvl={l} aria-pressed="false">{l}</button>)}
      </div>
    </div>

    <div class="secgrid">
      {SECTIONS.map((s) => <SectionCard section={s} guides={guides.filter((g) => g.data.section === s.id)} />)}
    </div>
  </section>
</Base>

<script>
  import { $, $$, esc } from '../../../scripts/lib';

  // ----- Фильтр по уровню -----
  const btns = $$<HTMLButtonElement>('.lvl');
  function applyLevel(l: string) {
    btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.lvl === l)));
    $$('.sec').forEach((sec) => {
      let shown = 0;
      $$<HTMLLIElement>('li[data-levels]', sec).forEach((li) => {
        const ok = !l || (li.dataset.levels || '').split(' ').includes(l);
        li.hidden = !ok;
        if (ok) shown++;
      });
      sec.classList.toggle('empty', shown === 0);
    });
    try { localStorage.setItem('lvl', l); } catch { /* приватный режим */ }
  }
  btns.forEach((b) => b.addEventListener('click', () => applyLevel(b.dataset.lvl || '')));
  try {
    const saved = localStorage.getItem('lvl');
    if (saved) applyLevel(saved);
  } catch { /* ignore */ }

  // ----- Поиск (Pagefind, индекс строится после astro build) -----
  const input = $<HTMLInputElement>('#q')!;
  const out = $('#res')!;
  let pf: any = null;
  let t = 0;
  async function load() {
    if (pf) return pf;
    try {
      const path = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/pagefind.js`;
      pf = await import(/* @vite-ignore */ path);
      await pf.options?.({ excerptLength: 18 });
    } catch {
      pf = false;
    }
    return pf;
  }
  input.addEventListener('focus', load, { once: true });
  input.addEventListener('input', () => {
    clearTimeout(t);
    t = window.setTimeout(async () => {
      const q = input.value.trim();
      if (q.length < 2) { out.innerHTML = ''; return; }
      const api = await load();
      if (!api) { out.innerHTML = '<div class="res empty">Поиск включится на опубликованном сайте.</div>'; return; }
      const r = await api.search(q);
      const items = await Promise.all(r.results.slice(0, 6).map((x: any) => x.data()));
      out.innerHTML = items.length
        ? items.map((d: any) => `<a class="res" href="${esc(d.url)}"><b>${esc(d.meta?.title || '')}</b><span>${d.excerpt}</span></a>`).join('')
        : `<div class="res empty">По запросу «${esc(q)}» пока ничего. Напиши в Telegram, и я разберу эту тему.</div>`;
    }, 180);
  });
</script>
