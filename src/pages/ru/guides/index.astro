---
import Base from '../../../layouts/Base.astro';
import SectionCard from '../../../components/SectionCard.astro';
import { SECTIONS } from '../../../data/sections';
import { LEVELS, SITE, url } from '../../../data/site';
import { getGuides, guideHref, plural } from '../../../lib/guides';
import { LEVEL_INFO } from '../../../lib/route';

const guides = await getGuides();
const pageUrl = new URL(url('/ru/guides/'), Astro.site).href;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: SITE.title,
    description: SITE.description,
    url: pageUrl,
    inLanguage: 'ru',
    hasPart: guides.map((g) => ({ '@type': 'Article', headline: g.data.title, url: new URL(guideHref(g), Astro.site).href })),
  },
];
const countOf = (id: string) => guides.filter((g) => g.data.section === id).length;
const countLevel = (l: string) => guides.filter((g) => (g.data.levels as string[]).includes(l)).length;
---
<Base title="Гайды по Goethe-Zertifikat A1–C2 — бесплатно | Stellas" description={SITE.description} active="all" jsonld={jsonld} tone="gray">
  <section class="hub-hero wrap">
    <p class="eyebrow">Гайды · Goethe-Zertifikat A1–C2</p>
    <h1 class="display">Сдай Goethe. <span class="grad">Без паники.</span></h1>
    <p class="lede">{guides.length} бесплатных гайдов, официальные пробники с разбором и тренажёры прямо на странице.</p>

    <label class="search">
      <span class="sr">Поиск по гайдам</span>
      <svg class="ic"><use href="#i-search" /></svg>
      <input id="q" type="search" placeholder="Поиск: «письмо другу», Hören, баллы…" autocomplete="off" />
    </label>
    <div class="results" id="res" aria-live="polite"></div>
  </section>

  <div class="wrap">
    <section class="howto rv" id="start" aria-labelledby="howto-h">
      <h2 class="hub-h2" id="howto-h">С чего начать</h2>
      <ol class="howto-steps">
        <li><span class="rnum">1</span><div><b>Выбери свой уровень</b><p>Ниже карточки A1–C2. Откроется маршрут: что читать и в каком порядке.</p></div></li>
        <li><span class="rnum">2</span><div><b>Сдай пробник</b><p>Официальный пробник Goethe и наш бланк. Узнаешь баллы и слабое место.</p></div></li>
        <li><span class="rnum">3</span><div><b>Тренируй слабое</b><p>Гайды по модулю, где меньше всего баллов. С тренажёрами и аудио.</p></div></li>
      </ol>
      <div class="plan-cta">
        <div><b>Знаешь дату экзамена?</b><p>Составь план по неделям под свой уровень и результаты пробника.</p></div>
        <a class="btn" href={url('/ru/guides/plan/')}>Мой план</a>
      </div>
    </section>

    <section class="levels-sec rv" aria-labelledby="lv-h">
      <h2 class="hub-h2" id="lv-h">Выбери свой уровень</h2>
      <div class="lvl-cards">
        {LEVELS.map((l) => (
          <a class="lvl-card" href={url(`/ru/guides/uroven/${l.toLowerCase()}/`)} style={`--c:${LEVEL_INFO[l].color}`}>
            <span class="lvl-big">{l}</span>
            <b>{LEVEL_INFO[l].title}</b>
            <span class="lvl-text">{LEVEL_INFO[l].text}</span>
            <span class="go">{countLevel(l)} {plural(countLevel(l), 'гайд', 'гайда', 'гайдов')} · открыть маршрут <svg class="ic"><use href="#i-chevron-right" /></svg></span>
          </a>
        ))}
      </div>
      <p class="lvl-help"><svg class="ic"><use href="#i-info" /></svg> Не знаешь, какой уровень нужен для визы, работы или учёбы? <a href={url('/ru/guides/pruefung/goethe-zertifikat-urovni/')}>Уровни A1–C2 и для чего каждый</a></p>
    </section>

    <section class="inside rv" aria-labelledby="in-h">
      <h2 class="hub-h2" id="in-h">Что внутри гайдов</h2>
      <div class="inside-grid">
        <div><span class="tile" style="--c:var(--deep);--ts:36px"><svg class="ic"><use href="#i-sparkles" /></svg></span><b>Коротко</b><span>Главное в 5 пунктах в начале каждого гайда</span></div>
        <div><span class="tile" style="--c:var(--teal);--ts:36px"><svg class="ic"><use href="#i-list-checks" /></svg></span><b>Бланк пробника</b><span>Отмечаешь ответы, получаешь баллы и разбор</span></div>
        <div><span class="tile" style="--c:var(--lime);--ts:36px"><svg class="ic"><use href="#i-pen-line" /></svg></span><b>Тренажёр письма</b><span>Таймер, счётчик слов, проверка формы</span></div>
        <div><span class="tile" style="--c:var(--pink);--ts:36px"><svg class="ic"><use href="#i-headphones" /></svg></span><b>Аудио</b><span>Слушаешь 1–2 раза, как на экзамене</span></div>
        <div><span class="tile" style="--c:var(--sun);--ts:36px"><svg class="ic"><use href="#i-messages-square" /></svg></span><b>Диалоги</b><span>Нажми на реплику, и она прозвучит</span></div>
        <div><span class="tile" style="--c:var(--violet);--ts:36px"><svg class="ic"><use href="#i-brain" /></svg></span><b>Квиз</b><span>Проверка с объяснением каждой ошибки</span></div>
      </div>
    </section>

    <section aria-labelledby="all-h">
      <h2 class="hub-h2" id="all-h">Все гайды по разделам</h2>
      <p class="hub-sub">Если уже знаешь, что ищешь.</p>
      <nav class="cats" aria-label="Разделы">
        {SECTIONS.map((s) => (
          <a class="cat" href={`#g-${s.id}`}>
            <span class="tile" style={`--c:${s.color}`}><svg class="ic"><use href={`#i-${s.icon}`} /></svg></span>
            {s.id === 'pruefung' ? 'Об экзамене' : s.id === 'probniki' ? 'Пробники' : s.id === 'grammatik' ? 'Грамматика' : s.de}
            <small>{countOf(s.id)} {plural(countOf(s.id), 'гайд', 'гайда', 'гайдов')}</small>
          </a>
        ))}
      </nav>
      <div class="groups">
        {SECTIONS.map((s) => <SectionCard section={s} guides={guides.filter((g) => g.data.section === s.id)} />)}
      </div>
    </section>
  </div>
</Base>

<script>
  import { $, esc, onReady } from '../../../scripts/lib';

  onReady(() => {
    // ----- Поиск (Pagefind, индекс строится после astro build) -----
    const input = $<HTMLInputElement>('#q')!;
    const out = $('#res')!;
    let pf: any = null;
    let t = 0;
    async function load() {
      if (pf !== null) return pf;
      try {
        const path = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/pagefind.js`;
        pf = await import(/* @vite-ignore */ path);
        await pf.options?.({ excerptLength: 18 });
      } catch {
        pf = false;
      }
      return pf;
    }
    input.addEventListener('focus', load, { once: true });
    input.addEventListener('input', () => {
      clearTimeout(t);
      t = window.setTimeout(async () => {
        const q = input.value.trim();
        if (q.length < 2) { out.innerHTML = ''; return; }
        const api = await load();
        if (!api) { out.innerHTML = '<div class="res empty">Поиск включится на опубликованном сайте.</div>'; return; }
        const r = await api.search(q);
        const items = await Promise.all(r.results.slice(0, 6).map((x: any) => x.data()));
        out.innerHTML = items.length
          ? items.map((d: any) => `<a class="res" href="${esc(d.url)}"><b>${esc(d.meta?.title || '')}</b><span>${d.excerpt}</span></a>`).join('')
          : `<div class="res empty">По запросу «${esc(q)}» пока ничего. Напиши в Telegram, и мы разберём эту тему.</div>`;
      }, 160);
    });
  });
</script>
