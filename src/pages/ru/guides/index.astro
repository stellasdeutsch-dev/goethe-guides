---
import Base from '../../../layouts/Base.astro';
import SectionCard from '../../../components/SectionCard.astro';
import { SECTIONS } from '../../../data/sections';
import { LEVELS, SITE, url } from '../../../data/site';
import { getGuides, guideHref, plural } from '../../../lib/guides';

const guides = await getGuides();
const pageUrl = new URL(url('/ru/guides/'), Astro.site).href;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: SITE.title,
    description: SITE.description,
    url: pageUrl,
    inLanguage: 'ru',
    hasPart: guides.map((g) => ({ '@type': 'Article', headline: g.data.title, url: new URL(guideHref(g), Astro.site).href })),
  },
];
const countOf = (id: string) => guides.filter((g) => g.data.section === id).length;
---
<Base title="Гайды по Goethe-Zertifikat A1–C2 — бесплатно | Stellas" description={SITE.description} active="all" jsonld={jsonld} tone="gray">
  <section class="hub-hero wrap">
    <p class="eyebrow">Гайды · Goethe-Zertifikat</p>
    <h1 class="display">Сдай Goethe. <span class="grad">Без паники.</span></h1>
    <p class="lede">Учу немецкий в Австрии. Разбираю экзамен так, как хотел бы, чтобы разобрали мне. Формат. Ловушки. Тренажёры.</p>

    <label class="search">
      <span class="sr">Поиск по гайдам</span>
      <svg class="ic"><use href="#i-search" /></svg>
      <input id="q" type="search" placeholder="Поиск: «письмо другу», Hören, баллы…" autocomplete="off" />
    </label>
    <div class="results" id="res" aria-live="polite"></div>

    <nav class="cats" aria-label="Разделы">
      {SECTIONS.map((s) => (
        <a class="cat" href={`#g-${s.id}`}>
          <span class="tile" style={`--c:${s.color}`}><svg class="ic"><use href={`#i-${s.icon}`} /></svg></span>
          {s.id === 'pruefung' ? 'Об экзамене' : s.id === 'grammatik' ? 'Грамматика' : s.de}
          <small>{countOf(s.id) ? `${countOf(s.id)} ${plural(countOf(s.id), 'гайд', 'гайда', 'гайдов')}` : 'скоро'}</small>
        </a>
      ))}
    </nav>
  </section>

  <div class="wrap">
    <div class="stats rv">
      <div class="stat"><b>4 модуля</b><span>Lesen, Hören, Schreiben, Sprechen</span></div>
      <div class="stat"><b>60 / 100</b><span>Проходной балл на модуль B1</span></div>
      <div class="stat"><b>A1–C2</b><span>Шесть уровней. Начинаем с B1</span></div>
      <div class="stat"><b>{guides.length}</b><span>{plural(guides.length, 'гайд', 'гайда', 'гайдов')} с тренажёрами. Бесплатно</span></div>
    </div>

    <div class="seg-wrap">
      <div class="seg" role="group" aria-label="Фильтр по уровню">
        <span class="thumb" aria-hidden="true"></span>
        <button type="button" data-lvl="" aria-pressed="true">Все</button>
        {LEVELS.map((l) => <button type="button" data-lvl={l} aria-pressed="false">{l}</button>)}
      </div>
    </div>

    <div class="groups">
      {SECTIONS.map((s) => <SectionCard section={s} guides={guides.filter((g) => g.data.section === s.id)} />)}
    </div>
  </div>
</Base>

<script>
  import { $, $$, esc, onReady, spring } from '../../../scripts/lib';

  onReady(() => {
    // ----- Сегментированный контроль: ползунок едет пружиной и прерывается новым нажатием -----
    const seg = $('.seg')!;
    const thumb = $<HTMLElement>('.thumb', seg)!;
    const btns = $$<HTMLButtonElement>('button', seg);
    const setX = (v: number) => (thumb.style.transform = `translateX(${v}px)`);
    const setW = (v: number) => (thumb.style.width = `${v}px`);
    const place = (b: HTMLButtonElement, animate: boolean) => {
      const x = b.offsetLeft, w = b.offsetWidth;
      // Без анимации: ставим на место и обнуляем скорость. С анимацией: пружина от текущего положения.
      const o = animate ? { response: 0.35, damping: 0.85 } : { from: x, velocity: 0 };
      spring(thumb, 'x', x, setX, o);
      spring(thumb, 'w', w, setW, animate ? o : { from: w, velocity: 0 });
    };

    function applyLevel(l: string, animate = true) {
      const b = btns.find((x) => x.dataset.lvl === l) || btns[0];
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      place(b, animate);
      $$('.group').forEach((g) => {
        const items = $$<HTMLLIElement>('li[data-levels]', g);
        let last: HTMLLIElement | null = null;
        items.forEach((li) => {
          const ok = !l || (li.dataset.levels || '').split(' ').includes(l);
          li.hidden = !ok;
          li.classList.remove('last-vis');
          if (ok) last = li;
        });
        (last as HTMLLIElement | null)?.classList.add('last-vis');
        g.classList.toggle('empty', !last);
      });
      try { localStorage.setItem('lvl', l); } catch { /* приватный режим */ }
    }
    btns.forEach((b) => b.addEventListener('click', () => applyLevel(b.dataset.lvl || '')));
    let saved = '';
    try { saved = localStorage.getItem('lvl') || ''; } catch { /* ignore */ }
    applyLevel(saved, false);
    window.addEventListener('resize', () => {
      const b = btns.find((x) => x.getAttribute('aria-pressed') === 'true');
      if (b) place(b, false);
    });
    document.fonts?.ready.then(() => {
      const b = btns.find((x) => x.getAttribute('aria-pressed') === 'true');
      if (b) place(b, false);
    });

    // ----- Поиск (Pagefind, индекс строится после astro build) -----
    const input = $<HTMLInputElement>('#q')!;
    const out = $('#res')!;
    let pf: any = null;
    let t = 0;
    async function load() {
      if (pf !== null) return pf;
      try {
        const path = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/pagefind.js`;
        pf = await import(/* @vite-ignore */ path);
        await pf.options?.({ excerptLength: 18 });
      } catch {
        pf = false;
      }
      return pf;
    }
    input.addEventListener('focus', load, { once: true });
    input.addEventListener('input', () => {
      clearTimeout(t);
      t = window.setTimeout(async () => {
        const q = input.value.trim();
        if (q.length < 2) { out.innerHTML = ''; return; }
        const api = await load();
        if (!api) { out.innerHTML = '<div class="res empty">Поиск включится на опубликованном сайте.</div>'; return; }
        const r = await api.search(q);
        const items = await Promise.all(r.results.slice(0, 6).map((x: any) => x.data()));
        out.innerHTML = items.length
          ? items.map((d: any) => `<a class="res" href="${esc(d.url)}"><b>${esc(d.meta?.title || '')}</b><span>${d.excerpt}</span></a>`).join('')
          : `<div class="res empty">По запросу «${esc(q)}» пока ничего. Напиши в Telegram, и я разберу эту тему.</div>`;
      }, 160);
    });
  });
</script>
