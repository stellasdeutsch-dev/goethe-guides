---
import RoutePage from '../../../../components/pages/RoutePage.astro';
import { readyTracks } from '../../../../lib/tracks';

export async function getStaticPaths() {
  return (await readyTracks('goethe')).map((t) => ({ params: { level: t.id }, props: { track: t.id } }));
}
const { track } = Astro.props as { track: string };
---
<RoutePage exam="goethe" track={track} />
