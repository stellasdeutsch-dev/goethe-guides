---
import RoutePage from '../../../../components/pages/RoutePage.astro';
import { LEVELS, type Level } from '../../../../data/site';
import { getGuides } from '../../../../lib/guides';

export async function getStaticPaths() {
  const all = await getGuides('goethe');
  return LEVELS.filter((l) => all.some((g) => (g.data.levels as string[]).includes(l))).map((l) => ({ params: { level: l.toLowerCase() }, props: { level: l } }));
}
const { level } = Astro.props as { level: Level };
---
<RoutePage exam="goethe" level={level} />
