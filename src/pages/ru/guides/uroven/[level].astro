---
import Base from '../../../../layouts/Base.astro';
import { LEVELS, SITE, url, type Level } from '../../../../data/site';
import { sectionById } from '../../../../data/sections';
import { getGuides, guideHref, plural, readingTime, slugOf, type Guide } from '../../../../lib/guides';
import { buildRoute, LEVEL_INFO, type RouteItem } from '../../../../lib/route';

export function getStaticPaths() {
  return LEVELS.map((l) => ({ params: { level: l.toLowerCase() }, props: { level: l } }));
}
const { level } = Astro.props as { level: Level };
const info = LEVEL_INFO[level];
const all = await getGuides();
const toItem = (g: Guide): RouteItem => ({ title: g.data.title, href: guideHref(g), section: g.data.section, minutes: readingTime(g.body), slug: slugOf(g) });
const steps = buildRoute(all, level, toItem);
const items = steps.flatMap((s) => s.groups.flatMap((g) => g.items));
const total = items.filter((i) => !i.external).length;
const minutes = items.reduce((n, i) => n + (i.minutes ?? 0), 0);
const tileOf = (section: string) => sectionById(section)!;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Маршрут подготовки к Goethe-Zertifikat ${level}`,
    itemListElement: items.filter((i) => !i.external).map((i, n) => ({ '@type': 'ListItem', position: n + 1, url: new URL(i.href, Astro.site).href, name: i.title })),
  },
];
---
<Base title={`Goethe ${level}: маршрут подготовки по шагам | Stellas`} description={`Пошаговый план подготовки к Goethe-Zertifikat ${level}: формат, официальный пробник, модули, грамматика и запись. ${total} бесплатных гайдов.`} active="all" jsonld={jsonld} tone="gray">
  <section class="route-hero wrap">
    <ol class="crumbs">
      <li><a href={url('/ru/guides/')}>Гайды</a></li>
      <li><svg class="ic"><use href="#i-chevron-right" /></svg></li>
      <li aria-current="page">Маршрут {level}</li>
    </ol>
    <div class="lvl-switch" role="navigation" aria-label="Другие уровни">
      {LEVELS.map((l) => <a href={url(`/ru/guides/uroven/${l.toLowerCase()}/`)} aria-current={l === level ? 'page' : undefined}>{l}</a>)}
    </div>
    <p class="eyebrow" style={`color:${info.color}`}>Маршрут · {info.title}</p>
    <h1 class="display">Goethe <span class="grad" style={`--g1:${info.color};--g2:var(--violet)`}>{level}</span>. По шагам.</h1>
    <p class="lede">{info.text}</p>
    <div class="route-meta">
      <span class="cap blue">{steps.length} {plural(steps.length, 'шаг', 'шага', 'шагов')}</span>
      <span class="cap">{total} {plural(total, 'гайд', 'гайда', 'гайдов')}</span>
      <span class="cap">≈ {Math.round(minutes / 60 * 10) / 10} ч чтения</span>
      <span class="cap" data-progress hidden></span>
    </div>
    <p class="route-how">Иди сверху вниз. Прочитанные гайды отмечаются галочкой сами, прогресс хранится в твоём браузере.</p>
    <p class="route-how"><a href={url('/ru/guides/plan/')}>Есть дата экзамена? Составь план по неделям →</a></p>
  </section>

  <div class="wrap">
    <ol class="route">
      {steps.map((s) => (
        <li class="rstep rv" id={`step-${s.n}`}>
          <div class="rstep-h">
            <span class="rnum">{s.n}</span>
            <div>
              <h2>{s.title}</h2>
              <p>{s.text}</p>
            </div>
          </div>
          {s.groups.map((g) => (
            <div class="rgroup">
              {g.label && (
                <div class="rgroup-h">
                  <span class="tile" style={`--c:${tileOf(g.section!).color};--ts:24px`}><svg class="ic"><use href={`#i-${tileOf(g.section!).icon}`} /></svg></span>
                  {g.label} <small>· {tileOf(g.section!).title}</small>
                </div>
              )}
              <ul class="list">
                {g.items.map((i) => (
                  <li>
                    <a class="row" href={i.href} data-route-href={i.external ? undefined : i.href} {...(i.external ? { rel: 'noopener', target: '_blank' } : {})}>
                      <span class="seen-ck" aria-hidden="true"><svg class="ic"><use href="#i-check" /></svg></span>
                      <span class="t">{i.title}</span>
                      {i.minutes ? <span class="cap">{i.minutes} мин</span> : <span class="cap">отдельный сайт</span>}
                      <svg class="ic chev"><use href={i.external ? '#i-arrow-up-right' : '#i-chevron-right'} /></svg>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </li>
      ))}
    </ol>

    <div class="route-end rv">
      <b>Прошёл маршрут?</b>
      <p>Реши пробник ещё раз за 3–5 дней до экзамена. Сравни баллы с первым разом. Вопросы пиши в <a href={SITE.telegram} rel="noopener" target="_blank">Telegram @stellasdeutsch</a>.</p>
    </div>
  </div>
</Base>

<script>
  import { $, $$, onReady } from '../../../../scripts/lib';
  onReady(() => {
    let seen: string[] = [];
    try { seen = JSON.parse(localStorage.getItem('seen') || '[]'); } catch { /* ignore */ }
    const rows = $$<HTMLAnchorElement>('[data-route-href]');
    let done = 0;
    rows.forEach((r) => {
      const ok = seen.includes(r.dataset.routeHref || '');
      r.classList.toggle('seen', ok);
      if (ok) done++;
    });
    const p = $('[data-progress]');
    if (p && done) { p.hidden = false; p.textContent = `Прочитано ${done} из ${rows.length}`; }
  });
</script>
