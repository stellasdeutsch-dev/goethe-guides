---
// Экран 1: какой экзамен. Ничего лишнего.
import Base from '../../layouts/Base.astro';
import { EXAMS, EXAM_IDS, type ExamId } from '../../data/exams';
import { url } from '../../data/site';
import { getGuides } from '../../lib/guides';

const ready: ExamId[] = [];
for (const e of EXAM_IDS) if ((await getGuides(e)).length) ready.push(e);
const SUB: Record<string, string> = { goethe: 'Goethe-Zertifikat', telc: 'telc Deutsch, DTZ', oesd: 'ÖSD Zertifikat' };
---
<Base title="Подготовка к экзаменам по немецкому: Goethe, telc, ÖSD | Stellas" description="Бесплатная подготовка к экзаменам по немецкому языку: Goethe-Zertifikat, telc Deutsch, ÖSD. Формат, пробники с разбором и гайды по каждой части." tone="gray">
  <section class="wrap screen">
    <p class="eyebrow">Экзамены по немецкому</p>
    <h1 class="display q-title">Какой экзамен <span class="grad">сдаёшь?</span></h1>
    <ul class="pick ex" role="list">
      {ready.map((e, i) => (
        <li style={`--i:${i}`}>
          <a class="pick-tile" href={url(`${EXAMS[e].base}/`)} style={`--c:${EXAMS[e].color}`}>
            <span class="ex-dot" aria-hidden="true"></span>
            <span class="pick-l">{EXAMS[e].name}</span>
            <span class="pick-t">{SUB[e]}</span>
          </a>
        </li>
      ))}
    </ul>
    <ul class="quiet" role="list">
      <li><a href={url('/ru/guides/pruefung/goethe-telc-oesd-testdaf/')}>Не знаешь, что выбрать? Сравнение экзаменов <svg class="ic"><use href="#i-chevron-right" /></svg></a></li>
    </ul>
  </section>
</Base>
